[b00t]
# 🤓 inference-qwen3 is the primary code intelligence profile
# 🤓 Qwen3-Coder-Next Q4_K_M = 48.4GB model; cpu-offload-gb 28 splits: 24GB VRAM + 28GB CPU RAM
# 💡例 b00t hive activate inference-qwen3
# ⚠️需 b00t hive status → confirm gpu_free_mb > 20000 and ram_available_gb > 16
name = "inference-qwen3"
type = "hive_profile"
hint = "llama-server Qwen3-Coder-Next Q4_K_M inference — full GPU + CPU offload via llama.cpp; NO concurrent downloads"

[b00t.hive.resources]
# 🤓 Qwen3-Coder-Next Q4_K_M = 48.4GB model; vllm cpu-offload-gb 28 splits load:
#   24GB VRAM (KV cache + hot layers) + 28GB CPU RAM (cold layers)
#   Total: ~30GB RAM committed. System has 31GB. Leave 1GB headroom.
ram_gb = 30
gpu_mb = 24000
cpu_cores = 4

[b00t.hive.resources.gate]
# Must have this much FREE before activating (otherwise refuse + suggest sm0l profile)
ram_free_gb = 16
gpu_free_mb = 20000

[b00t.hive.exclusion]
group = "primary-workload"
priority = 100

[b00t.hive.service]
# 🤓 service spec is source-of-truth; b00t hive activate generates b00t-hive-inference-qwen3.service
# 🤓 %h expands to home dir in systemd unit specifiers
# 🤓 LimitNOFILE bypasses ulimit for systemd; avoids fd exhaustion under load
# ⚠️需 ulimit prerequisite (run once as root):
#   echo "* soft nofile 65536" >> /etc/security/limits.conf
#   echo "* hard nofile 65536" >> /etc/security/limits.conf
# 🤓 vllm serving via GGUF — requires patched gguf+transformers+vllm (done in-place in .venv):
#   gguf>=0.18.0: adds QWEN3NEXT to MODEL_ARCH_NAMES
#   transformers/integrations/ggml.py: adds qwen3_next to GGUF_CONFIG_MAPPING
#   transformers/modeling_gguf_pytorch_utils.py: adds qwen3next TENSOR_PROCESSOR + arch remap
#   vllm/model_executor/model_loader/gguf_loader.py: adds qwen3_next to replace("_","") block
# 🤓 vllm --load-format gguf: loads multi-shard GGUF directly (no conversion needed)
# 🤓 cpu-offload-gb 28: splits 48.4GB model across 24GB VRAM + 28GB CPU RAM
# 🤓 Qwen3NextForCausalLM is natively implemented in vllm 0.17.x (qwen3_next.py)
description = "Qwen3-Coder-Next hive inference node via llama-server (port 8000)"
type = "simple"
limit_nofile = 65536
environment = [
    "PATH=/home/brianh/.venv/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin",
    "HF_HOME=/home/brianh/.cache/huggingface",
]
exec_start_pre = [
    "/bin/bash -c 'echo llama-server inference-qwen3 hive node starting on :8000'",
]
exec_start = """/usr/bin/podman run --rm \
    --name b00t-llama-server \
    --device nvidia.com/gpu=all \
    --security-opt=label=disable \
    -v %h/.cache/huggingface:/root/.cache/huggingface:ro,rslave \
    -p 8000:8000 \
    ghcr.io/ggml-org/llama.cpp:server-cuda \
    -m /root/.cache/huggingface/hub/models--Qwen--Qwen3-Coder-Next-GGUF/snapshots/b82fb7382639d97b38fa7672e526c760c2fb358e/Qwen3-Coder-Next-Q4_K_M/Qwen3-Coder-Next-Q4_K_M-00001-of-00004.gguf \
    --alias qwen3-coder \
    --port 8000 \
    -c 32768 \
    -ngl 25 \
    --host 0.0.0.0"""
restart = "on-failure"
restart_sec = "30s"
timeout_start_sec = "300"

# ─── Version prerequisites (declarative; future b00t hive check-prereqs support) ──
# 🤓 prereqs are NOT yet enforced by b00t hive activate — tracked here for visibility
#    Implementation plan: HivePrereq in hive.rs, run checks before activate_profile()
[[b00t.hive.prereqs]]
name = "podman-available"
check = "command -v podman"
hint = "podman required (sudo apt install podman)"

[[b00t.hive.prereqs]]
name = "llama-cuda-image"
check = "podman image exists ghcr.io/ggml-org/llama.cpp:server-cuda"
on_fail = "podman pull ghcr.io/ggml-org/llama.cpp:server-cuda"
hint = "podman pull ghcr.io/ggml-org/llama.cpp:server-cuda"

[[b00t.hive.prereqs]]
name = "nvidia-cdi-gpu"
check = "podman run --rm --device nvidia.com/gpu=all --security-opt=label=disable --entrypoint /bin/sh ghcr.io/ggml-org/llama.cpp:server-cuda -c 'ls /dev/nvidia* >/dev/null 2>&1'"
hint = "CDI GPU device not visible inside container; ensure nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml has been run and CDI is configured for podman"

[b00t.hive.services]
# 🤓 services.start is now empty because [b00t.hive.service] generates b00t-hive-inference-qwen3.service
# 🤓 keep this section for any ADDITIONAL pre-existing units to co-start
start = []
stop = []

[b00t.hive.mcp_tools]
activate = ["vllm-local", "opencode-local"]
deactivate = []

[[b00t.hive.guards]]
pattern = "pip install"
action = "warn"
message = "🦨 use uv pip install"
redirect = "uv pip install"

[[b00t.hive.guards]]
pattern = "docker run"
action = "warn"
message = "🦨 use podman (CDI GPU: --device nvidia.com/gpu=all --security-opt=label=disable)"

[[b00t.hive.guards]]
pattern = "hf download"
action = "warn"
message = "🦨 profile=inference-qwen3: active HF download competes for 31GB RAM pool with cpu-offload-gb 28; switch to download-mode first"

[[b00t.hive.guards]]
pattern = "huggingface-cli download"
action = "warn"
message = "🦨 profile=inference-qwen3: use 'hf download' (not deprecated huggingface-cli) and switch to download-mode first"

[[b00t.usage]]
description = "Activate full inference mode (generates+starts b00t-hive-inference-qwen3.service)"
command = "b00t hive activate inference-qwen3"

[[b00t.usage]]
description = "Enable stack to auto-start on login"
command = "systemctl --user enable b00t@inference-qwen3"

[[b00t.usage]]
description = "Check model readiness before activating"
command = "ls ~/.cache/huggingface/hub/models--Qwen--Qwen3-Coder-Next-GGUF/blobs/*.incomplete 2>/dev/null | wc -l"

[[b00t.usage]]
description = "Test opencode against local Qwen3-Coder-Next"
command = "opencode run --model vllm-local/qwen3-coder 'reply with only: HIVE_NODE_ONLINE'"

# b00t:map v1
# summary: inference-qwen3 hive profile — Qwen3-Coder-Next Q4_K_M via podman ghcr.io/ggml-org/llama.cpp:server-cuda
# tags: inference, llama-server, llama.cpp, qwen3, hive, gpu, service, podman, cuda
# tier: frontier
# cmds: b00t hive activate inference-qwen3, b00t hive plan inference-qwen3
# complexity: 6
# prereqs: podman + nvidia CDI; brew llama-server dropped (no CUDA on Linux)
