[b00t]
# 🤓 vLLM inference provider datum — OpenAI-compatible HTTP server for local LLM inference
# 🤓 Manages model serving, GPU utilization, and CPU offload configuration
# 🤓 Use b00t hive activate before starting to ensure resource gates are satisfied
name = "Vllm"
type = "inference_provider"
hint = "vLLM OpenAI-compatible local inference server; supports GGUF, safetensors, AWQ, GPTQ"

[b00t.cli]
detect = "vllm --version"
desires = ">=0.17.1"
install = "uv pip install vllm --python /home/brianh/.venv/bin/python3"

[b00t.api]
base_url = "http://localhost:8000/v1"
health_url = "http://localhost:8000/health"
models_url = "http://localhost:8000/v1/models"

# ─── Qwen3-Coder-Next Q4_K_M (PATCHED — vllm 0.17.1 requires .venv patches) ─────────────────
# ⚠️ vLLM 0.17.1 does NOT natively support Qwen3-Coder-Next GGUF without patching.
# See: scripts/venv-patches/qwen3-coder-next-gguf.sh for patch application.
# Status: BLOCKED — in_proj_qkvz.qweight uninitialized (SSM weight mapping incomplete)
# Fallback: use llama-server (inference-qwen3.stack.tomllm)
[[b00t.usage]]
description = "Serve Qwen3-Coder-Next Q4_K_M via vLLM (PATCHED — see scripts/venv-patches/)"
command = """/home/brianh/.venv/bin/vllm serve \
    ~/.cache/huggingface/hub/models--Qwen--Qwen3-Coder-Next-GGUF/snapshots/main/Qwen3-Coder-Next-Q4_K_M/Qwen3-Coder-Next-Q4_K_M-00001-of-00004.gguf \
    --served-model-name qwen3-coder \
    --port 8000 \
    --max-model-len 32768 \
    --gpu-memory-utilization 0.92 \
    --cpu-offload-gb 28 \
    --enforce-eager \
    --trust-remote-code"""

# ─── Prove vLLM works with a smaller/safer model ──────────────────────────────────────────────
# 🤓 Use this to verify vLLM installation is functional before attempting GGUF patches
[[b00t.usage]]
description = "Prove vLLM works: serve Qwen3.6 (see qwen36-local.model.ai datum for variants)"
command = """/home/brianh/.venv/bin/vllm serve Qwen/Qwen3.6-27B \
    --served-model-name ch0nky \
    --port 8000 \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.85"""

[[b00t.usage]]
description = "Prove vLLM works: serve Qwen3-8B (safetensors, small enough for 24GB VRAM)"
command = """/home/brianh/.venv/bin/vllm serve Qwen/Qwen3-8B \
    --served-model-name qwen3-8b \
    --port 8000 \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.85"""

[[b00t.usage]]
description = "Test vLLM endpoint after serving"
command = """curl -s http://localhost:8000/v1/chat/completions \
    -H 'Content-Type: application/json' \
    -d '{"model":"qwen3-8b","messages":[{"role":"user","content":"reply with only: VLLM_ONLINE"}],"max_tokens":10}' | jq .choices[0].message.content"""

# ─── GGUF patch tracking ───────────────────────────────────────────────────────────────────────
# 🤓 Patches applied to /home/brianh/.venv for Qwen3-Coder-Next GGUF support
# 🤓 Re-apply after any venv rebuild: bash scripts/venv-patches/qwen3-coder-next-gguf.sh
[[b00t.patches]]
file = "transformers/integrations/ggml.py"
description = "Add qwen3_next config mapping (all fields + MoE + SSM)"
status = "applied"

[[b00t.patches]]
file = "transformers/modeling_gguf_pytorch_utils.py"
description = "Add qwen3next to TENSOR_PROCESSORS + arch remap qwen3next→qwen3_next"
status = "applied"

[[b00t.patches]]
file = "vllm/model_executor/model_loader/gguf_loader.py"
description = "Add qwen3_next SSM tensor mapping block (dt_bias + MoE experts)"
status = "applied"

[[b00t.patches]]
file = "vllm/model_executor/models/qwen3_next.py"
description = "ParallelLMHead quant_config + conv1d.weight unsqueeze(1) + 1D→2D reshape guard"
status = "applied"

[[b00t.patches]]
file = "gguf>=0.18.0"
description = "MODEL_ARCH.QWEN3NEXT + qwen3next in MODEL_ARCH_NAMES"
status = "applied"

# ─── Remaining gaps (for future upstream fix) ─────────────────────────────────────────────────
[[b00t.known_issues]]
issue = "in_proj_qkvz.qweight uninitialized — SSM input projection GGUF→vLLM mapping incomplete"
status = "open"
hint = "gguf.get_tensor_name_map maps model.layers.X.linear_attn.in_proj_qkvz → blk.X.ssm_in but GGUFUninitializedParameter for qweight is never filled; upstream vLLM issue"

# b00t:map v1
# summary: vLLM inference provider — OpenAI-compatible local LLM server with GGUF patch tracking
# tags: vllm, inference, llm, server, gguf, openai-compatible
# tier: frontier
# cmds: vllm serve <model> --port 8000
# complexity: 7
# prereqs: uv pip install vllm; see patches for Qwen3-Coder-Next GGUF support
