[b00t]
# 🤓 Justfile datum for the app4dog workspace root justfile
# 🤓 Registers this justfile for agent-executable recipes via just-mcp
# 🤓 Only registered justfiles are in scope — unregistered = absent from agent view
# 💡例 b00t cli check just-mcp  → verify just-mcp can serve this datum
# 💡例 b00t justfile list app4dog  → list all registered recipe groups
# ⚠️需 just binary must be installed: cargo install just
# 🔗参 app4dog--workspace.stack.tomllm  → system map referencing this datum
name    = "app4dog"
type    = "justfile"
hints   = "app4dog workspace justfile — CI, ACR, CVAT, Metaflow, dev-up/down"

[b00t.justfile]
# 🤓 path is relative to the project root (resolved at runtime by just-mcp)
path        = "justfile"
mcp_server  = "just-mcp"
recipe_groups = ["dev", "db", "ci", "docker", "acr", "cvat", "ml", "proxy", "health"]
allowed_sandboxes = ["none", "ebpf"]   # none = direct; ebpf = future eBPF scoped
allow_side_effects = true
# ⚠️需 require declares runtime deps; sandbox validates before granting execution
require     = ["docker", "just", "tofu"]

[b00t.justfile.capabilities]
# 🤓 eBPF-scoped capabilities — a tested contract, not a request
# 🤓 Undeclared paths are absent from the agent's filesystem view
network     = true                      # docker pull, azure CLI, terraform
filesystem  = [
    ".",                                # workspace root
    "/mnt/blobfuse2-ml-training",       # ML training datasets
    "~/.kube",                          # kubectl config
]
env_vars    = ["AZURE_*", "DOCKER_*", "HUGGING_FACE_HUB_TOKEN", "B00T_*"]
secrets     = ["ACR_ADMIN_PASSWORD", "OPENAI_API_KEY"]

[b00t.learn]
topic = "app4dog-workspace"
inline = """
app4dog workspace justfile — key recipe groups:
  dev:    just dev-up / dev-down / logs
  db:     just db-is-up / db-diagnose / db-reset
  ci:     just ci-test-full / ci-db-up / ci-db-down
  acr:    just acr-login / acr-build-cvat / acr-mirror-base
  cvat:   just cvat-local-up / cvat-azure-up / cvat-azure-stop
  ml:     just ml-train-local / ml-train-cloud / ml-runs
"""

entangled_mcp = ["just-mcp.mcp"]
entangled_cli = ["just.cli", "docker.cli"]
depends_on    = ["just.cli"]
