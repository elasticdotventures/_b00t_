# PRD-ARCH-007: Learn-embedded justfile blessings

[b00t.schema]
version   = "1"
type      = "prd"
type_tags = ["prd", "blessing", "pattern", "learn", "session", "bouncer", "justfile"]

[prd]
id     = "PRD-ARCH-007-LEARN-JUSTFILE-BLESSINGS"
title  = "Learn-embedded justfile blessings — persist memoized skills as just recipes"
status = "proposed"
tier   = "sm0l"
closes_task = 34

# ─── Executive Summary ───────────────────────────────────────────────────────
# `b00t learn <topic>` renders skill content into agent context (ephemeral).
# Skills acquired during a session vanish at session end — no persistence.
# This PRD adds `b00t learn --bless <topic>` which writes the rendered skill
# as a `just` recipe into the local justfile, making the skill permanently
# available via `just <topic>` and discoverable by future agents without
# reloading learn content.

[current_state]
learn_cmd     = "b00t learn <topic> — renders skill template into context"
learn_persist = "none — ephemeral; lost at session end"
justfile      = "./justfile — casey/just command runner; `just -l` lists recipes"
missing       = ["skill persistence", "just recipe generation", "bouncer validation on bless"]

[blessing_protocol]
# "Blessing" = persisting a skill as a just recipe
# b00t learn --bless <topic> does:
#   1. render b00t learn <topic>
#   2. extract key commands from rendered output
#   3. format as just recipe with docstring
#   4. append to ./justfile under [group: blessings]
#   5. run bouncer validate on the new recipe
#   6. emit: "🍀 blessed <topic> into justfile"
bless_cmd    = "b00t learn --bless <topic>"
unbless_cmd  = "b00t learn --unbless <topic>"
list_cmd     = "b00t learn --list-blessings"
just_group   = "blessings"

[recipe_format]
# Generated just recipe format
example = """
# [blessing: rust] — auto-generated by b00t learn --bless rust
[group('blessings')]
@rust-check:
    cargo check --all-targets 2>&1 | head -50

[group('blessings')]
@rust-test:
    cargo test --workspace 2>&1

[group('blessings')]
@rust-fmt:
    cargo fmt --all
    cargo clippy --fix --allow-dirty
"""

[bouncer_integration]
# All bless operations go through bouncer validation
# bouncer checks: no rm -rf, no secrets, no network write ops, idempotent
validate_cmd = "b00t bouncer validate --input <recipe> --context blessing"
on_reject    = "print rejection reason; do NOT write to justfile"

[session_hook]
# session_end hook: auto-bless any topic used > N times in session
auto_bless_threshold = 3
hook_cmd  = "b00t session-hook learn-bless --threshold=3"

[implementation]
new_flags   = ["--bless", "--unbless", "--list-blessings"]
modify      = ["b00t-cli/src/commands/learn.rs"]
new_file    = "b00t-cli/src/commands/learn_bless.rs"
justfile    = "./justfile — append [group: blessings] section"
bouncer     = "b00t-cli/src/commands/bouncer.rs — add blessing validation context"

[acceptance]
must = [
  "b00t learn --bless rust appends valid just recipes to ./justfile under [group('blessings')]",
  "b00t learn --list-blessings shows all persisted blessings",
  "bouncer rejects bless if recipe contains rm -rf or network write ops",
  "just rust-check runs without error after blessing",
]
should = [
  "session_end hook auto-blesses topics used >= 3 times",
  "b00t learn --unbless <topic> removes recipe from justfile",
]

[[related]]
datum = "PRD-ARCH-008-CONTROLFLOW-GATE-ONTOLOGY"
note  = "gate bouncer validation covers bless operations"

# b00t:map v1
# summary: persist b00t learn skills as just recipes via --bless; bouncer-validated; session-hook auto-bless
# tags: prd, learn, blessing, justfile, bouncer, session, sm0l
# tier: sm0l
# cmds: b00t learn --bless rust; b00t learn --list-blessings; just rust-check
# complexity: 4
