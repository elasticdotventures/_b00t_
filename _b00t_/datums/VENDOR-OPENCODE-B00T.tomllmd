# b00t Vendor Datum — opencode-b00t (OpenCode Integration)
# 🤓 b00tyverse fork of sst/opencode — upstream: github.com/sst/opencode (dev branch)
#    Fork: github.com/PromptExecution/opencode-b00t (dev branch)
#    Language: TypeScript + Bun
#    Path: vendor/opencode-b00t
#
# Sync: `git fetch upstream && git rebase upstream/dev`
# PRs:  upstream (sst/opencode) ← fork (PromptExecution/opencode-b00t)

[b00t]
name = "VENDOR-OPENCODE-B00T"
type = "vendor"
hint = "b00tyverse fork of sst/opencode — AI coding assistant with b00t hive integration (agent hooks, skills, MCP tools)"

[b00t.version]
schema = 1
content = "synced"

[b00t.vendor]
path = "vendor/opencode-b00t"
upstream = "https://github.com/sst/opencode.git"
upstream_branch = "dev"
fork = "https://github.com/PromptExecution/opencode-b00t.git"
fork_branch = "dev"
build_command = "bun install && bun run build"
install_command = "./install"
health_check = "test -d vendor/opencode-b00t && ls vendor/opencode-b00t/packages/ | wc -l | grep -v '^0$'"
required_tools = ["git", "bun"]

[b00t.maintenance]
update_frequency = "weekly"
review_required = true
sync_command = "git fetch upstream && git rebase upstream/dev"
