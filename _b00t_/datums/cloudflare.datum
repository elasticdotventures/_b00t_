# b00t Cloudflare Datum — Semantic Truth Source for Cloudflare Infrastructure
# .tomllmd — valid TOML with enriched comment conventions
# schema: 1 | bump on field definition changes
# last_updated: 2026-05-04
# 🤓 This datum is the canonical source of truth for all Cloudflare infrastructure
#    consumed by b00t agents. It documents the provider topology, credential paths,
#    service inventory, and integration contracts.
#
# 🔗参 _b00t_/datums/CLOUDFLARE-EXTERNAL-INTERFACE.tomllmd — Rust trait contracts
# 🔗参 _b00t_/env.d — generated env var bindings
# 🔗参 vendor/l3dg3rr/crates/b00t-iface/ — lifecycle management interfaces
# 🔗参 https://developers.cloudflare.com/

[b00t]
name = "CLOUDFLARE"
type = "datum"
hint = "Cloudflare infrastructure datum — provider topology, credential paths, service inventory, integration contracts for b00t's cloud layer"

[b00t.version]
schema = 1
content = "draft"

# ── Provider Identity ──────────────────────────────────────────────────────
[cloudflare.provider]
name = "cloudflare"
kind = "AbstractCloudProvider"
version = "1"
account_id = "f00c391669432ae2a423c04a001dab2d"
zone_id = "df9acd5c921098ee3a6bb9ecff5b500f"
plan = "workers-paid"
region = "global"
description = "Cloudflare — global edge network, 180+ cities, Workers AI GPU compute"

# ── Env Var Bindings (detected from ~/.b00t/.env) ─────────────────────────
# 🤓 These env vars are auto-detected by `b00t doctor` and used by cloudflare
#    subcommands and MCP integrations. Set in ~/.b00t/.env or ~/.hermes/.env.
[cloudflare.env]
CLOUDFLARE_API_TOKEN = { type = "api-token", hint = "CF API Token with worker/d1/r2/kv/vectorize permissions", detected = false }
CLOUDFLARE_ACCOUNT_ID = { type = "string", hint = "Account ID: f00c391669432ae2a423c04a001dab2d", detected = false }
CLOUDFLARE_ZONE_ID = { type = "string", hint = "Zone ID: df9acd5c921098ee3a6bb9ecff5b500f", detected = false }
CLOUDFLARE_TUNNEL_TOKEN = { type = "secret", hint = "cloudflared tunnel token for Zero Trust", detected = false }
CLOUDFLARE_EMAIL = { type = "email", hint = "Cloudflare account email", detected = false }
CLOUDFLARE_API_KEY = { type = "api-key", hint = "Legacy API key (prefer API Token)", detected = false }
CLOUDFLARE_R2_ACCESS_KEY = { type = "access-key", hint = "R2 S3-compatible access key", detected = false }
CLOUDFLARE_R2_SECRET_KEY = { type = "secret", hint = "R2 S3-compatible secret key", detected = false }
CLOUDFLARE_R2_ENDPOINT = { type = "url", hint = "R2 S3 endpoint URL", detected = false }
CLOUDFLARE_D1_TOKEN = { type = "api-token", hint = "D1 database API token", detected = false }
CLOUDFLARE_WORKERS_AI_TOKEN = { type = "api-token", hint = "Workers AI API token", detected = false }
CLOUDFLARE_WORKERS_AI_ACCOUNT_ID = { type = "string", hint = "Workers AI account (same as CLOUDFLARE_ACCOUNT_ID)", detected = false }
MCP_REMOTE_CLIENT_ID = { type = "oauth-client", hint = "OAuth client ID for remote MCP", detected = false }
MCP_REMOTE_CLIENT_SECRET = { type = "secret", hint = "OAuth client secret for remote MCP", detected = false }
CF_ACCESS_CLIENT_ID = { type = "access-client", hint = "Cloudflare Access service token ID", detected = false }
CF_ACCESS_CLIENT_SECRET = { type = "secret", hint = "Cloudflare Access service token secret", detected = false }

# ── Service Inventory ──────────────────────────────────────────────────────
# Each service is a capability that b00t can discover and use.
[cloudflare.services.ai]
name = "Workers AI"
kind = "inference"
status = "active"
plan = "paid"
endpoint = "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run/{model}"
models = ["@cf/meta/llama-3.1-70b-instruct", "@cf/meta/llama-3.3-70b-instruct", "@hf/nousresearch/hermes-2-pro-mistral-7b"]
capabilities = ["chat", "embedding", "image-generation", "transcription", "tts", "reranking", "tool-calling", "structured-output", "streaming"]
features = ["128k-context", "80-tps", "gpu-180-cities", "auto-rag"]
sdk = { rust = "cloudflare-ai", js = "workers-ai-provider" }

[cloudflare.services.agents]
name = "Cloudflare Agents"
kind = "agent-framework"
status = "active"
plan = "workers-paid"
sdk = { js = "@cloudflare/agents" }
patterns = ["prompt-chaining", "routing", "parallelization", "orchestrator-workers", "evaluator-optimizer"]
storage = ["durable-objects", "d1-sql", "kv", "r2"]
comms = ["websockets", "queues", "email"]
features = ["mcp-server", "scheduling", "stateful-sessions", "auto-rag"]

[cloudflare.services.d1]
name = "D1"
kind = "database"
status = "active"
plan = "paid"
type = "sqlite"
endpoint = "https://api.cloudflare.com/client/v4/accounts/{account_id}/d1/database/{db_id}/query"
sdk = { rust = "cloudflare-rs", js = "d1" }
features = ["sql", "backups", "time-travel-restore", "replication"]

[cloudflare.services.r2]
name = "R2"
kind = "storage"
status = "active"
plan = "paid"
type = "s3-compatible"
endpoint = "https://{account}.r2.cloudflarestorage.com/{bucket}"
sdk = { rust = "aws-sdk-s3", js = "@aws-sdk/client-s3" }
features = ["s3-api", "no-egress-fees", "public-buckets", "custom-domains"]

[cloudflare.services.kv]
name = "Workers KV"
kind = "key-value-store"
status = "active"
plan = "paid"
endpoint = "https://api.cloudflare.com/client/v4/accounts/{account_id}/storage/kv/namespaces/{ns_id}/values/{key}"
sdk = { rust = "cloudflare-rs", js = "kv" }
features = ["global-replication", "ttl", "bulk-writes"]

[cloudflare.services.vectorize]
name = "Vectorize"
kind = "vector-database"
status = "active"
plan = "paid"
endpoint = "https://api.cloudflare.com/client/v4/accounts/{account_id}/vectorize/v2/indexes/{index}/query"
sdk = { rust = "cloudflare-rs", js = "vectorize" }
features = ["cosine-similarity", "euclidean-distance", "dot-product", "metadata-filtering"]

[cloudflare.services.queues]
name = "Queues"
kind = "message-queue"
status = "active"
plan = "paid"
type = "pull-based"
features = ["at-least-once", "batch-processing", "dead-letter-queues", "consumer-workers"]

[cloudflare.services.durable_objects]
name = "Durable Objects"
kind = "stateful-compute"
status = "active"
plan = "paid"
features = ["single-writer", "transactions", "websockets", "alarms", "storage-api"]

[cloudflare.services.ai_gateway]
name = "AI Gateway"
kind = "llm-proxy"
status = "active"
plan = "paid"
features = ["caching", "rate-limiting", "observability", "cost-tracking", "fallback-routing"]

[cloudflare.services.autorag]
name = "AutoRAG"
kind = "rag-pipeline"
status = "beta"
plan = "paid"
features = ["auto-chunking", "auto-embedding", "vectorize-index", "r2-ingestion", "semantic-search"]

[cloudflare.services.secrets_store]
name = "Secrets Store"
kind = "secret-management"
status = "beta"
plan = "paid"
features = ["dek-kek-encryption", "shared-across-workers", "wrangler-cli", "versioning"]

[cloudflare.services.tunnel]
name = "Cloudflare Tunnel"
kind = "network-tunnel"
status = "active"
plan = "free"
binary = "cloudflared"
features = ["zero-trust", "no-open-ports", "load-balancing", "argo-tunnel", "warp-connector"]

[cloudflare.services.container_platform]
name = "Container Platform"
kind = "container-orchestration"
status = "preview"
plan = "paid"
features = ["gpu-support", "smart-placement", "docker-compatible"]

[cloudflare.services.realtime]
name = "RealtimeKit"
kind = "real-time-communication"
status = "active"
plan = "paid"
features = ["webrtc", "mobile-sdks", "voice-video", "transcription", "recording"]

[cloudflare.services.artifacts]
name = "Artifacts"
kind = "versioned-storage"
status = "private-beta"
plan = "paid"
features = ["git-compatible", "rest-api", "workers-binding", "fork", "import-from-github", "per-session-repos", "10k-forks"]

[cloudflare.services.email]
name = "Email Service"
kind = "email"
status = "public-beta"
plan = "paid"
features = ["send-receive", "workers-binding", "rest-api", "spf-dkim-dmarc-auto", "sdk-typescript-python-go", "agents-sdk-onemail-hook", "bidirectional"]

[cloudflare.services.workflows]
name = "Workflows"
kind = "durable-execution"
status = "ga"
plan = "paid"
features = ["v2-control-plane", "souschef-gatekeeper", "agents-sdk-integration", "per-step-retry", "human-in-the-loop", "high-throughput-instances"]

# ── Credential Provider Chain ──────────────────────────────────────────────
# 🤓 Resolution order: Worker bindings > ~/.b00t/.env > ~/.hermes/.env > env
[cloudflare.credentials]
provider = "env-chain"
resolution_order = [
    { source = "worker-binding", priority = 1, hint = "env.AI, env.DB during Worker execution" },
    { source = "env-b00t", priority = 2, path = "~/.b00t/.env" },
    { source = "env-hermes", priority = 3, path = "~/.hermes/.env" },
    { source = "process-env", priority = 4, hint = "std::env::var fallback" },
    { source = "wrangler-toml", priority = 5, hint = "wrangler.toml [vars] section" },
    { source = "secrets-store", priority = 6, hint = "Cloudflare Secrets Store (beta)" },
]

# ── Capability Target — b00t Agent Dispatch ────────────────────────────────
# 🤓 Agents dispatched to Cloudflare targets use these capabilities
[cloudflare.agent]
dispatch_role = "cloudflare-operator"
capabilities = [
    "workers-ai-inference",
    "d1-query",
    "r2-storage",
    "kv-cache",
    "vectorize-search",
    "queue-publish",
    "durable-object-invoke",
    "tunnel-manage",
    "ai-gateway-route",
    "autorag-query",
    "dns-manage",
]
default_model = "@cf/meta/llama-3.1-70b-instruct"
default_tools = ["workers-ai", "d1", "r2", "kv", "vectorize", "queues", "kv"]
mcp_transport = { type = "remote-sse", base_url = "https://mcp.{zone}.workers.dev", auth = "cf-access-oauth" }

# ── Infrastructure Registration — ledgrrr coordination ────────────────────
# 🤓 b00t coordinates with infrastructure manager via ledgrrr ledger entries.
#    Each resource type has a registration pattern that gets logged as a
#    FOCUS CostAndUsage record for cost attribution.
[cloudflare.resources]
root_domain = "promptexecution.com"
zone_id = "df9acd5c921098ee3a6bb9ecff5b500f"
account_id = "f00c391669432ae2a423c04a001dab2d"

[[cloudflare.resources.workers]]
name = "b00t-cloud-api"
runtime = "javascript"
plan = "paid"
endpoint = "https://b00t.promptexecution.com"
bindings = ["AI", "D1", "R2", "KV", "Vectorize", "Queues"]

[[cloudflare.resources.workers]]
name = "b00t-mcp-remote"
runtime = "javascript"
plan = "paid"
endpoint = "https://mcp.promptexecution.com/sse"
bindings = ["D1", "KV", "AI"]

[[cloudflare.resources.d1_databases]]
name = "b00t-state"
type = "sqlite"
plan = "paid"

[[cloudflare.resources.r2_buckets]]
name = "b00t-artifacts"
type = "s3"
plan = "paid"

[[cloudflare.resources.r2_buckets]]
name = "b00t-logs"
type = "s3"
plan = "paid"

# ── MCP Server Template — Remote MCP over SSE ──────────────────────────────
# 🤓 Use mcp-remote to bridge stdio MCP servers to remote HTTP/SSE:
#    npx mcp-remote@latest https://mcp.promptexecution.com/sse
#    See: https://github.com/geelen/mcp-remote
#    OAuth config at: https://developers.cloudflare.com/agents/guides/remote-mcp-server/
[cloudflare.mcp]
transport = "remote-sse"
client = "mcp-remote"
install = "npx mcp-remote@latest"
oauth = { provider = "cf-access", flow = "authorization-code", pkce = true }

[[cloudflare.mcp.servers]]
name = "cloudflare-workers-ai"
command = "npx"
args = ["mcp-remote@latest", "https://ai.promptexecution.com/sse"]
description = "Cloudflare Workers AI MCP — LLM inference, embeddings, image gen"

[[cloudflare.mcp.servers]]
name = "cloudflare-vectorize"
command = "npx"
args = ["mcp-remote@latest", "https://vectorize.promptexecution.com/sse"]
description = "Vectorize MCP — semantic search across indexed knowledge"

[[cloudflare.mcp.servers]]
name = "cloudflare-d1"
command = "npx"
args = ["mcp-remote@latest", "https://d1.promptexecution.com/sse"]
description = "D1 MCP — SQL query access to b00t-state database"

# ── Official Cloudflare MCP Servers (remote HTTPS, OAuth) ─────────────────
# 🤓 Cloudflare publishes 5 official MCP servers at mcp.cloudflare.com.
#    These are remote HTTPS servers with automatic OAuth via CF Zero Trust.
#    Setup: https://developers.cloudflare.com/agent-setup/
#    Quick setup prompt: curl https://developers.cloudflare.com/agent-setup/prompt.md
#    OAuth triggers automatically on first tool use.
[[cloudflare.mcp.servers]]
name = "cloudflare"
url = "https://mcp.cloudflare.com/mcp"
description = "Cloudflare platform MCP — manage Workers, D1, R2, KV, Queues, AI Gateway, DNS, Zones. OAuth via Cloudflare Zero Trust"
transport = "remote-https"
auth = "cf-oauth"

[[cloudflare.mcp.servers]]
name = "cloudflare-docs"
url = "https://docs.mcp.cloudflare.com/mcp"
description = "Cloudflare Docs MCP — search and query official Cloudflare documentation. Public, no authentication required"
transport = "remote-https"
auth = "none"

[[cloudflare.mcp.servers]]
name = "cloudflare-bindings"
url = "https://bindings.mcp.cloudflare.com/mcp"
description = "Cloudflare Bindings MCP — manage Worker bindings (D1, R2, KV, Queues, AI, Vectorize). OAuth required"
transport = "remote-https"
auth = "cf-oauth"

[[cloudflare.mcp.servers]]
name = "cloudflare-builds"
url = "https://builds.mcp.cloudflare.com/mcp"
description = "Cloudflare Builds MCP — deploy and manage Worker builds, wrangler integration. OAuth required"
transport = "remote-https"
auth = "cf-oauth"

[[cloudflare.mcp.servers]]
name = "cloudflare-observability"
url = "https://observability.mcp.cloudflare.com/mcp"
description = "Cloudflare Observability MCP — query Worker logs, traces, metrics, and error reporting. OAuth required"
transport = "remote-https"
auth = "cf-oauth"

# ── Claude Code Plugin ─────────────────────────────────────────────────────
# 🤓 Claude Code users can install Cloudflare agent tooling via plugins:
#    claude plugin marketplace add cloudflare/skills
#    claude plugin install cloudflare@cloudflare
#    Then /reload-plugins in Claude Code session.

# ── Monitoring Configuration ───────────────────────────────────────────────
# 🤓 Cloudflare is one of the first companies b00t monitors.
#    Service health and cost tracking are logged to R2 + ledgrrr.
[cloudflare.monitoring]
enabled = true
interval = "1h"
log_target = "r2://b00t-logs/cloudflare-monitoring"
cost_tracking = { enabled = true, provider = "ledgrrr-focus", schema = "FOCUS v1.3" }

[cloudflare.monitoring.services]
workers_ai = { check = "health", endpoint = "https://api.cloudflare.com/client/v4/accounts/{id}/ai/run/@cf/meta/llama-3.1-70b-instruct", method = "POST" }
d1 = { check = "health", endpoint = "https://api.cloudflare.com/client/v4/accounts/{id}/d1/database" }
r2 = { check = "health", endpoint = "https://{account}.r2.cloudflarestorage.com" }
tunnel = { check = "process", command = "cloudflared tunnel list" }

