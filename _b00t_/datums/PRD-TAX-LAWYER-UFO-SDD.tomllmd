status = "blocked"
depends_on = [510]
blocks     = [514]
labels = ["us", "tax", "rd-credit", "irc-41", "domain-ontology", "rust"]

[issue.512.story]
narrow = '''
As a tax-lawyer agent filing a US R&D Tax Credit for a US subsidiary of
an Australian parent, I need to:
  (1) apply the IRC Sec 41(d) 4-part test to determine QRE eligibility
  (2) classify expenditures as QREs under Sec 41(b)
  (3) calculate the credit using traditional (12-20%) or ASC (14-27%) method
  (4) produce evidence for Form 6765
'''

[issue.512.definitions_of_done]
four_part_test = '''
Create ledger-core/src/us_rdc.rs with:

pub struct QreActivity {
    pub lei: Lei,
    pub activity_id: String,
    // 4-part test per IRC Sec 41(d)(1):
    pub permits_experimentation: bool,   // (A)
    pub technical_in_nature: bool,        // (B)
    pub technological_uncertainty: bool,  // (C)
    pub systematic_process: bool,         // (D)
}

impl Satisfies<UsRdcFourPartTest> for QreActivity {
    // All 4 parts must be satisfied → Satisfied
    // Any part false → Violated with reason citing the subsection
}
Test: cargo test -p ledger-core -- us_rdc_four_part
DoD: All 4-part test combinations tested, Violated reason includes
     specific IRC Sec 41(d) subsection reference.
'''

calculation = '''
pub enum UsRdcMethod { Traditional, Asc }

pub fn calculate_credit(qres: &[QreExpenditure], method: UsRdcMethod, base: Option<Decimal>) -> Decimal
// Traditional: 20% of QREs over base amount (Sec 41(a)(1))
// ASC: 14% of QREs over 50% of 3-year average (Sec 41(c)(5))

Test: cargo test -p ledger-core -- us_rdc_calculate
DoD: Both methods produce correct values for known test cases.
'''

