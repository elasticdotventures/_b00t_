# ═══════════════════════════════════════════════════════════════════════════════
# ISSUE #514: MCP action layer — thin JSON-RPC wrappers over Satisfies
# ═══════════════════════════════════════════════════════════════════════════════
[issue.514]
title = "MCP action layer: contract.rs TaxArgs + mcp_adapter.rs handlers — thin wrappers over Satisfies<Constraint>"
status = "blocked"
depends_on = [511, 512, 513]
blocks     = [515]
labels = ["mcp", "ledgerr_tax", "contract", "integration", "rust"]

[issue.514.story]
narrow = '''
As a tax-lawyer agent, I need to call MCP tools (ledgerr_tax) that dispatch
to the domain ontology's Satisfies implementations. Each MCP action MUST
be a thin deserialize → satisfies → respond wrapper (5-10 lines), with
all domain logic in the Satisfies implementations from #511-#513.
'''

[issue.514.definitions_of_done]
# The key design constraint: contract.rs TaxArgs variants MUST NOT define
# any domain logic. They only:
#   (a) deserialize JSON-RPC arguments into domain types
#   (b) call satisfies() on the domain type
#   (c) serialize SatisfiesResult back to JSON-RPC response

tax_args = '''
In crates/ledgerr-mcp/src/contract.rs, extend TaxArgs:

pub enum TaxArgs {
    // Existing 5 actions preserved unchanged
    Assist { ... },
    // ... existing ...

    // NEW: AU R&D (thin wrappers only)
    AuRdCheckEligibility {
        lei: String,
        activity_descriptor: String,
    },
    AuRdClassifyExpenditure {
        lei: String,
        tx_ids: Vec<String>,
    },
    AuRdCalculateOffset {
        lei: String,
        year: i32,
        turnover: Decimal,
    },

    // NEW: US R&D
    UsRdcFourPartTest {
        lei: String,
        activity_descriptor: String,
    },

    // NEW: Crypto (jurisdiction-dispatched)
    CryptoCostBasis {
        lei: String,
        wallet_address: String,
        method: CostBasisMethod,
        jurisdiction: Jurisdiction,
    },
}

PUBLISHED_TOOLS entry for TAX_TOOL adds the 5 new action names.
'''

adapter_handlers = '''
In crates/ledgerr-mcp/src/mcp_adapter.rs, each handler is ≤10 lines:
  TaxArgs::AuRdCheckEligibility { lei, activity_descriptor } => {
      let activity = ledger_core::au_rd::AuRdActivity { lei: Lei::new(&lei)?, ... };
      let result = activity.satisfies(&AuRdEligibility::new());
      serde_json::to_value(result).unwrap_or(error_response("serialize failed"))
  }

Symmetrically for all 5 new variants.
No handler may contain domain logic beyond deserialize-call-respond.
'''

regen_docs = '''
After contract.rs changes:
  cargo run -p ledgerr-mcp --bin regen-docs
  # This regenerates docs/mcp-capability-contract.md,
  # docs/agent-mcp-runbook.md, scripts/mcp_cli_demo.sh
  git diff --exit-code docs/mcp-capability-contract.md  # must match generated

Test: cargo test -p ledgerr-mcp -- tax
DoD: All new actions return correct SatisfiesResult JSON,
     regen-docs produces no diff from checked-in files.
'''

[issue.514.handler_examples]
# Concrete example showing the thin-wrapper pattern
AuRdCheckEligibility_handler = '''
fn handle_au_rd_eligibility(service: &TurboLedgerService, args: &Value) -> Value {
    let lei = args["lei"].as_str()?;
    let descriptor = args["activity_descriptor"].as_str()?;
    let activity = AuRdActivity::new(Lei::new(lei).ok()?, descriptor);
    let result = activity.satisfies(&AuRdEligibility::new(2026));
    json!(result)
}
'''

