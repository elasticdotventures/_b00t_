# PRD-SDD: Tax-Lawyer Platform — UFO-grounded multi-jurisdiction tax ontology + satisfies constraint system
#
# This document is both a Project Requirements Document and a
# Specification Design Document. It defines the what (PRD) and
# the how (SDD) for building an ontologically-grounded tax-lawyer
# agent platform on the b00t/l3dg3rr ecosystem.
#
# The architecture combines:
#   MCP-down: 10 published ledgerr_* MCP tools, extended with new
#             tax-specific actions; each action is a thin JSON-RPC
#             wrapper over a Satisfies<Constraint> check.
#   UFO-up:   Unified Foundational Ontology stereotypes grounding
#             every domain concept (Endurant/Perdurant/Moment) with
#             ISO standard types as the data language and satisfies
#             as the evaluation pattern.
#
# Issues: #510 (EPIC), #511–#517 (implementation)
# Related: #341 (kreuzberg), #398 (latent space paper parsing),
#          #504–#508 (ATO legislation pipeline)

[b00t.schema]
version   = "1"
type      = "prd"
type_tags = ["prd", "sdd", "tax", "ufo", "iso", "ontology", "satisfies",
             "au-rd", "us-rdc", "crypto", "ledgrrr", "mcp", "frontier",
             "tax-lawyer", "multi-jurisdiction"]

[prd]
id     = "PRD-TAX-LAWYER-UFO-SDD"
title  = "Tax-Lawyer Platform — UFO-grounded multi-jurisdiction R&D/crypto ontology + satisfies constraint system"
status = "proposed"
tier   = "frontier"
closes_task = 0
epic_issue  = 510
related     = [341, 398, 504, 505, 506, 507, 508]

# ─── Executive Summary ────────────────────────────────────────────────────────
# The codebase has:
#  - ledgrrr (10 published MCP tools, arc-kit-au evidence graph, legal solver)
#  - b00t skills (31 SKILL.md files, .skill.toml symlinks, SkillResolver)
#  - UFO/BFO ontology PRDs (not yet implemented in Rust)
#  - ISO 8601/4217 usage (light, ad-hoc)
#  - Crypto classification Rhai rules (US only, no AU)
#  - No R&D tax credit logic at all (AU or US)
#
# What is missing:
#  (a) UFO stereotypes grounded in Rust types (no ufo-types crate exists)
#  (b) ISO standard types as the data language (LEI, ISO 20022, IFRS 9)
#  (c) Satisfies<Constraint> trait as the evaluation pattern
#  (d) AU R&D Tax Incentive (ITAA 1997 Div 355) domain logic
#  (e) US R&D Tax Credit (IRC Sec 41) domain logic
#  (f) Cross-jurisdiction crypto cost basis (IRS Rev. Proc. 2024-28 + ATO QC 53725)
#  (g) MCP actions that are thin wrappers over (a)-(f) rather than ad-hoc enums
#  (h) SKILL.md content teaching agents the ontology + constraint pattern
#
# This PRD-SDD closes all seven gaps in seven issues (#510–#515)
# under one epic (#509).

# ─── Architecture Diagram (conceptual) ──────────────────────────────────────
# ┌─────────────────────────────────────────────────────┐
# │                  SKILL.md content                    │
# │  Agents learn UFO stereotypes, ISO types, satisfies │
# │  → "I know this is an AuRdActivity (Endurant::SubKind)" │
# └─────────────────────┬───────────────────────────────┘
#                       │ agent calls
#                       ▼
# ┌─────────────────────────────────────────────────────┐
# │            MCP action layer (ledgerr_tax)            │
# │  Thin JSON-RPC wrappers over Satisfies<Constraint>   │
# │  Each action = 5-10 lines, deserialize → call → respond │
# └─────────────────────┬───────────────────────────────┘
#                       │ dispatches to
#                       ▼
# ┌─────────────────────────────────────────────────────┐
# │            Domain ontology (ledger-core)              │
# │  AuRdActivity, QreExpenditure, CryptoTx              │
# │  Each implements Satisfies<Constraint>                │
# │  Grounded via UFO stereotype markers                  │
# └──────┬──────────────────────────────┬────────────────┘
#        │ uses                          │ produces
#        ▼                               ▼
# ┌──────────────┐           ┌──────────────────────────┐
# │  ufo-types   │           │  arc-kit-au evidence     │
# │  UFO cats    │           │  Blake3-hashed nodes     │
# │  ISO types   │           │  provenance chains       │
# │  Satisfies   │           │  → ATO/IRS audit-ready   │
# └──────────────┘           └──────────────────────────┘

# ─── Issue Map ──────────────────────────────────────────────────────────────
#  #510  EPIC: Tax-Lawyer Platform                          (this PRD)
#    │
#    ├── #511  ufo-types crate: stereotypes + Satisfies + ISO  [FOUNDATION]
#    │   └── Blocks #512, #513, #514, #515, #516, #517
#    │
#    ├── #512  AU R&D Tax Incentive ontology + satisfies       [AU]
#    │   └── Depends on #511; blocks #516
#    │
#    ├── #513/514  US R&D Tax Credit ontology + satisfies      [US]
#    │   └── Depends on #511; blocks #516
#    │
#    ├── #514/515  Crypto cost basis ontology + satisfies      [BOTH]
#    │   └── Depends on #511; blocks #516
#    │
#    ├── #515/516  MCP action layer: thin wrappers            [INTEGRATION]
#    │   └── Depends on #512, #513, #514
#    │
#    └── #516/517  Skill content: SKILL.md tax-lawyer/* files [CONTENT]
#        └── Independent — can start before #511
#                                       (ships the knowledge, tools ship later)

# ═══════════════════════════════════════════════════════════════════════════════
# ISSUE #510: ufo-types crate — UFO stereotypes, Satisfies trait, ISO types
# ═══════════════════════════════════════════════════════════════════════════════
[issue.510]
title = "ufo-types crate: UFO stereotypes, Satisfies trait, ISO standard types"
status = "ready"
tier  = "frontier"
depends_on = []
blocks     = [511, 512, 513, 514, 515]
labels = ["ufo", "ontology", "iso", "satisfies", "foundation", "rust"]

[issue.510.story]
narrow = '''
As a tax-lawyer agent, I need a formal ontological foundation so that every
domain concept (R&D Activity, Tax Credit, Crypto Transaction) is grounded in
a UFO stereotype with ISO-standard identifiers and a uniform satisfies
constraint pattern. This crate is the bottom of the stack — everything else
depends on it.
'''

[issue.510.definitions_of_done]
# ── 510.1: UFO category types ──
ufo_categories = '''
Create ufo-types/src/lib.rs with:

pub enum UfoCategory { Endurant{stereotype}, Perdurant{stereotype}, Moment{stereotype}, Abstract }
pub enum EndurantStereotype { Kind, SubKind, Role, Phase, Category, Mixin, RoleMixin }
pub enum PerdurantStereotype { Process, State, Event, Scenario }
pub enum MomentStereotype { Mode, Relator }

Each variant MUST have:
- doc comment with UFO citation (Guizzardi 2005)
- Serialize/Deserialize/JsonSchema derives
- Display impl for ontology logging

Test: cargo test -p ufo-types -- ufo_categories
DoD: All 12 enum variants exist, all derive macros pass, all doc comments cite sources.
'''

# ── 510.2: Satisfies trait ──
satisfies_trait = '''
Create ufo-types/src/satisfies.rs with:

pub trait Satisfies<C: Constraint + ?Sized> {
    fn satisfies(&self, constraint: &C) -> SatisfiesResult;
}

pub struct SatisfiesResult {
    pub disposition: Disposition,       // Satisfied | Violated{reason} | Unknown
    pub confidence: f64,                // [0.0, 1.0]
    pub evidence_nodes: Vec<NodeId>,    // arc-kit-au Blake3 node IDs
    pub ufo_category: MomentStereotype, // always Mode (intrinsic attribute)
}

pub enum Disposition { Satisfied, Violated{reason: String}, Unknown }

Example — a company checking R&D eligibility:
  let company = Company { lei: "5493001K..." };
  let result = company.satisfies(&AuRdEligibility::new(year));
  assert!(matches!(result.disposition, Disposition::Satisfied));

Test: cargo test -p ufo-types -- satisfies
DoD: Satisfies trait compiles, SatisfiesResult roundtrips through JSON,
     Disposition has all three variants with Display impl.
'''

# ── 510.3: ISO standard types ──
iso_types = '''
Create ufo-types/src/iso.rs with:

pub struct Lei(String);              // ISO 17442 — 20-char, Luhn check digit
pub struct Isin(String);             // ISO 6166 — 12-char
pub enum Currency { Aud, Usd, Eur, Gbp, Sgd, Nzd, Btc, Eth, ... }
pub struct BankAccount {
    pub iban: Option<String>,        // ISO 13616
    pub bic: Option<String>,         // ISO 9362
    pub lei: Option<Lei>,
}
pub enum FinancialInstrument { Fvpl, Fvoci, AmortizedCost }  // IFRS 9

Each ISO type MUST:
- Validate on construction (Lei: check digit, Currency: from_str("AUD") etc.)
- Serialize/Deserialize/JsonSchema
- Have Display for logging

Example:
  let lei = Lei::new("5493001KJTIIG5Y0YH28").unwrap();
  assert_eq!(lei.as_str(), "5493001KJTIIG5Y0YH28");

Test: cargo test -p ufo-types -- iso
DoD: Lei validates check digit, Currency roundtrips through JSON,
     BankAccount serializes with optional fields.
'''

# ── 510.4: Integration with ledger-core ──
integration = '''
Wire ufo-types into ledger-core/src/lib.rs:
  pub extern crate ufo_types;
  // Re-export key types for convenience
  pub use ufo_types::{Satisfies, SatisfiesResult, Disposition, Lei, Currency};

Verify no dependency conflicts:
  cargo check -p ledger-core 2>&1 | grep -q "error" && exit 1 || exit 0

DoD: ledger-core depends on ufo-types, re-exports Satisfies trait,
     cargo check passes.
'''

# ── 510.5: Evidence graph integration ──
evidence_integration = '''
Arc-kit-au SHOULD be updated with note that NodeId prefixes will be used
by SatisfiesResult.evidence_nodes. No code change required in #510 itself
(the evidence integration happens in #511-#513).

DoD: README or doc comment in arc-kit-au/src/lib.rs mentions
     "SatisfiesResult.evidence_nodes" as known consumer.
'''

[issue.510.files_to_create]
ufo_lib  = "crates/ufo-types/src/lib.rs"
satisfies = "crates/ufo-types/src/satisfies.rs"
iso      = "crates/ufo-types/src/iso.rs"
cargo    = "crates/ufo-types/Cargo.toml"

