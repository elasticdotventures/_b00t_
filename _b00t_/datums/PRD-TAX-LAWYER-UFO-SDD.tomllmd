[issue.511]
title = "AU R&D Tax Incentive: AuRdActivity, AuRdExpenditure, AuRdOffset + satisfies<AuRdEligibility>"
status = "blocked"
depends_on = [510]
blocks     = [514]
labels = ["au", "tax", "rd-incentive", "itaa1997", "domain-ontology", "rust"]

[issue.511.story]
narrow = '''
As a tax-lawyer agent preparing an AU R&D Tax Incentive claim for
PromptExecution, I need to:
  (1) register an R&D activity under ITAA 1997 s.355-100
  (2) classify expenses under s.355-305
  (3) calculate the offset (43.5% or 38.5%)
  (4) build an evidence chain for ATO audit defense

Each step MUST produce Blake3-hashed evidence nodes so the claim
is audit-ready from day one.
'''

[issue.511.example]
prompt = "Classify $120,000 of OpenAI API costs as eligible R&D expenditure under s.355-305"
output = '''
SatisfiesResult {
    disposition: Satisfied,
    confidence: 0.94,
    evidence_nodes: [
        NodeId("tx:abc123"),       // Xero transaction
        NodeId("cls:def456"),      // Classification → s.355-305 "contractor"
        NodeId("st:ghi789"),       // Stage result passes all gates
    ],
    ufo_category: Mode,
    // Explanation: OpenAI API calls were part of systematic A/B experiments
    // on agent architectures (ooda_loop experiments tracked in FOCUS).
    // Each API call had an experiment_id, variant, and scored outcome.
    // This satisfies s.355-305(1)(a): "expenditure on research and development
    // activities that are core R&D activities."
}
'''

[issue.511.definitions_of_done]
