# ISSUE #513: Crypto cost basis — cross-jurisdiction ontology + satisfies
# ═══════════════════════════════════════════════════════════════════════════════
[issue.513]
title = "Crypto cost basis: CryptoTx + satisfies<CryptoCostBasisRules> (FIFO/HIFO/LIFO/SpecID) with AU and US jurisdiction dispatch"
status = "blocked"
depends_on = [510]
blocks     = [514]
labels = ["crypto", "cost-basis", "irs", "ato", "multi-jurisdiction", "domain-ontology", "rust"]

[issue.513.story]
narrow = '''
As a tax-lawyer agent handling crypto transactions for a multi-national company,
I need to calculate cost basis under both US rules (Rev. Proc. 2024-28) and
AU rules (ATO QC 53725) from the same underlying transaction data. The wallet
must support FIFO, HIFO, LIFO, and SpecID methods per Rev. Proc. 2024-28.
'''

[issue.513.example]
prompt = '''
Calculate cost basis for 1.5 BTC sold on 2026-03-15 from wallet
0xabc...def using HIFO method. Jurisdiction: AU (CGT regime).
'''
output = '''
CryptoTx {
    tx_hash: "abc...def",
    wallet: CryptoWallet { lei: "5493001K...", chain: Bitcoin },
    tx_type: Sell,
    gross_proceeds: Decimal("180000.00"),   // $180,000 AUD
    cost_basis: Decimal("120000.00"),       // HIFO from wallet pool
    gain_loss: Decimal("60000.00"),          // Capital gain
    date: 2026-03-15,
    evidence_nodes: [
        NodeId("tx:abc...def"),      // Raw blockchain tx
        NodeId("cb:hifo-001"),       // HIFO cost basis calculation
        NodeId("cg:aud-001"),        // ATO CGT calculation
    ],
    // AU treatment: held > 12 months → 50% CGT discount (ITAA 1997 s.115-A)
    // Net taxable gain: $30,000 after discount
}
'''

[issue.513.definitions_of_done]
wallet = '''
Create ledger-core/src/crypto.rs with:

