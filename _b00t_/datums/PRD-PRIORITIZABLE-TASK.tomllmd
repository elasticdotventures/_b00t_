# b00t:map v1
# summary: PrioritizableTask — a task primitive with knowledge graph linkages, dependency blocking, checklist behavior, and operator syntax sugar. Proposes tools for sifting agentic brilliance from hallucination trash.
# tags: prd, task, prioritizable, knowledge-graph, checklist, operator, syntax-sugar, reviewer, triage, eureka, hallucination
# tier: frontier
# cmds: b00t task add, b00t task dep, b00t task graph, b00t task checklist, b00t task promote
# complexity: 9

# ── PRD: PrioritizableTask + Knowledge Graph Linkages ────────────────────────

[b00t.schema]
version   = "1"
type      = "prd"
type_tags = ["prd", "task", "knowledge-graph", "checklist", "operator", "reviewer"]

[prd]
id     = "PRD-PRIORITIZABLE-TASK"
title  = "PrioritizableTask — dependency-aware tasks with knowledge graph linkages and checklist behavior"
status = "proposed"
tier   = "frontier"

# ── Executive Summary ────────────────────────────────────────────────────────
# Current b00t task system supports: add, list, next, done, update, show, dep.
# Missing: prioritization beyond 1-4 scale, knowledge graph linkages for
# traceability, checklist/blocking semantics, and operator ergonomics.
#
# This PRD proposes PrioritizableTask — a task type that:
#   1. Becomes a checklist when decomposition is needed
#   2. Links to codebase-memory graph nodes (functions, files, issues)
#   3. Supports dependency blocking with automatic unblock detection
#   4. Provides operator syntax sugar for rapid triage and organization

# ── Problem Space ────────────────────────────────────────────────────────────

## The Reviewer's Challenge
# Reviewers sift through agentic output — millions of monkey-Shakespeare tokens —
# to find the real Eureka brilliance. The signal-to-noise ratio is brutal:
#   - Hallucinated API calls look plausible
#   - Generated code passes syntax but fails semantics
#   - Multi-agent outputs conflict at the boundary layer
#   - "Brilliance" often hides in throwaway asides, not main outputs
#
# A PrioritizableTask system helps by:
#   - Linking task outputs to the knowledge graph (trace: "this code came from this task")
#   - Blocking downstream tasks until upstream validation passes
#   - Checklist decomposition for systematic verification
#   - Operator triage tools to rapidly assess output quality

## Current Limitations
[current_state]
task_format        = "JSON in .b00t/tasks.json"
priority_scale     = "1-4 only (critical through low)"
dependency_support = "task dep add/rm (manual, no auto-unblock)"
knowledge_graph    = "NOT linked to codebase-memory graph"
checklist_mode     = "NOT supported — tasks are monolithic"
operator_triage    = "b00t task list only — no filtering, grouping, or scoring"

# ── PrioritizableTask Design ─────────────────────────────────────────────────

## Schema Extension
[task_schema]
# New fields appended to existing task JSON schema
new_fields = {
    "checklist": {
        "type": "array",
        "description": "Sub-items when task is decomposed into checklist",
        "items": {
            "id": "string (slug)",
            "label": "string",
            "status": "pending|done|blocked|skipped",
            "verification": "string (how to verify this item is done)",
            "output_ref": "string (path to output artifact)"
        }
    },
    "graph_links": {
        "type": "array",
        "description": "Knowledge graph node references for traceability",
        "items": {
            "node_type": "Function|File|PR|Issue|Datum|Agent",
            "qualified_name": "string",
            "relationship": "produces|modifies|depends_on|reviews|validates",
            "project": "string (codebase-memory project name)"
        }
    },
    "risk_score": {
        "type": "float",
        "description": "0.0-1.0 risk that this task produces hallucinated output",
        "factors": ["author_experience", "complexity", "dependency_depth", "novelty"]
    },
    "review_policy": {
        "type": "string",
        "description": "How this task's output should be reviewed",
        "enum": ["auto-approve", "checklist", "single-reviewer", "multi-framework", "adversarial-bounce"]
    },
    "blocked_by": {
        "type": "array",
        "description": "Task IDs that block this task (auto-computed from dep graph)",
        "items": "uint"
    },
    "unblock_conditions": {
        "type": "object",
        "description": "Conditions that auto-unblock when met",
        "pattern": {
            "all_deps_done": "bool",
            "review_passed": "bool", 
            "tests_green": "bool",
            "operator_approval": "bool"
        }
    }
}

# ── Knowledge Graph Linkages ─────────────────────────────────────────────────

## Link Types
[graph_linkages]
# Tasks become first-class nodes in the codebase-memory graph
# Edge types connecting tasks to code artifacts:

edges = [
    {
        "edge": "TASK_PRODUCES",
        "from": "PrioritizableTask",
        "to": "Function|File",
        "meaning": "This task created this code"
    },
    {
        "edge": "TASK_MODIFIES", 
        "from": "PrioritizableTask",
        "to": "Function|File",
        "meaning": "This task changed this code"
    },
    {
        "edge": "TASK_REVIEWS",
        "from": "PrioritizableTask",
        "to": "PR|Commit",
        "meaning": "This task reviews this artifact"
    },
    {
        "edge": "TASK_DEPENDS_ON",
        "from": "PrioritizableTask",
        "to": "PrioritizableTask",
        "meaning": "Upstream dependency (blocked until done)"
    },
    {
        "edge": "TASK_VALIDATES",
        "from": "PrioritizableTask", 
        "to": "PrioritizableTask",
        "meaning": "This task validates the output of another task"
    },
    {
        "edge": "TASK_REFERENCES",
        "from": "PrioritizableTask",
        "to": "Datum|Issue",
        "meaning": "This task references this datum or issue"
    }
]

## Query Power
# With graph linkages, operators can ask:
graph_queries = [
    "What code did this task produce? → trace_path TASK_PRODUCES",
    "What tasks depend on this file changing? → reverse trace TASK_MODIFIES",
    "Which review tasks are blocked? → filter blocked_by is not empty",
    "What's the blast radius of this task? → transitive closure of TASK_DEPENDS_ON",
    "Which tasks touch security-sensitive code? → intersect with security_surface_area",
    "Is this Hallucination or Eureka? → trace task → produced code → trace callers → verify"
]

# ── Operator Syntax Sugar — Tools & Skills ───────────────────────────────────

## Command Proposals
[operator_tools]
# Tools that make operators more effective at task organization and triage

tools = [
    {
        "name": "b00t task graph [--format mermaid|json]",
        "description": "Render task dependency graph. Shows blocked/unblocked, parallel-ready tasks.",
        "example": "b00t task graph --format mermaid > .b00t/task-graph.md"
    },
    {
        "name": "b00t task checklist <id>",
        "description": "Toggle a task into checklist mode. Bulk-add sub-items from template or LLM decomposition.",
        "example": "b00t task checklist 16 --decompose 'review all datum files for tail-map compliance'"
    },
    {
        "name": "b00t task promote <id>",
        "description": "Promote a checklist item or finding to its own task. Creates dependency link automatically.",
        "example": "b00t task promote 16 --item 3  # promotes checklist item 3 to new task"
    },
    {
        "name": "b00t task triage [--risk] [--stale] [--blocked]",
        "description": "Operator triage view: sort by risk score, flag stale tasks, show blocked chain.",
        "example": "b00t task triage --risk --blocked  # what needs attention now?"
    },
    {
        "name": "b00t task link <id> --node <qualified_name> --rel produces",
        "description": "Link task to knowledge graph node. Creates TASK_PRODUCES edge.",
        "example": "b00t task link 16 --node 'b00t-cli/src/task.rs' --rel modifies"
    },
    {
        "name": "b00t task verify <id> [--checklist]",
        "description": "Verify task completion: run checklist verifications, check graph linkages, validate output.",
        "example": "b00t task verify 16 --checklist"
    },
    {
        "name": "b00t task batch <status> [--limit N]",
        "description": "Batch operations: mark multiple tasks, bulk-link, bulk-triage.",
        "example": "b00t task batch blocked --mark ready  # unblock all satisfied dependencies"
    }
]

## Just Recipe Syntax Sugar
[just_sugar]
# Just recipes that make common operator workflows one-liners

recipes = [
    {
        "recipe": "just task-graph",
        "desc": "Render current task graph to terminal",
        "impl": "b00t task graph --format mermaid | mermaid-cli",
    },
    {
        "recipe": "just task-next-batch",
        "desc": "Show next N parallel-ready tasks",
        "impl": "b00t task triage --ready --limit 5",
    },
    {
        "recipe": "just task-review-queue",
        "desc": "Show all review tasks with risk scores",
        "impl": "b00t task triage --tag reviewer --risk",
    },
    {
        "recipe": "just task-blocked-chain <id>",
        "desc": "Show what's blocking this task and what it blocks",
        "impl": "b00t task graph --root <id> --direction both",
    },
    {
        "recipe": "just task-checklist-all",
        "desc": "Run verification on all active checklist tasks",
        "impl": "b00t task triage --checklist --verify",
    }
]

# ── Hallucination vs Eureka — The Reviewer's Triage Problem ───────────────────

## Signal Detection Heuristics
[signal_detection]
# Automated heuristics for flagging potential hallucinations vs genuine insights

hallucination_indicators = [
    "API call to function that doesn't exist in the codebase",
    "Import of module not in dependency graph",
    "Configuration key not found in any config schema",
    "Type mismatch between caller and callee (detectable via graph)",
    "Output that contradicts a VERIFIED fact in the knowledge graph",
    "Confidence expressed in areas where the agent has no training data",
]

eureka_indicators = [
    "Novel abstraction that simplifies 3+ existing patterns",
    "Cross-domain connection between unrelated codebase clusters",
    "Non-obvious optimization supported by complexity metrics",
    "Pattern recognized across multiple PRs/commits (temporal awareness)",
    "Solution that eliminates a known TRIZ contradiction",
    "Refactoring that reduces cyclomatic complexity by >30%",
]

## Triage Workflow
[triage_workflow]
# 1. Agent produces output → task marked "pending-review"
# 2. Automated checks run: link to graph, verify references exist, check types
# 3. Hallucination indicators flagged → task risk_score elevated
# 4. Eureka indicators flagged → task promoted for deeper review
# 5. Operator (or reviewer agent) triages: trash or treasure?
# 6. Treasure → promoted to datum/skill/library | Trash → lfmf lesson recorded

# ── Implementation Phases ────────────────────────────────────────────────────

[implementation]
phases = [
    {
        "phase": 1,
        "name": "Checklist Support",
        "description": "Add checklist array to task schema. b00t task checklist <id> creates/decomposes.",
        "effort": "ch0nky",
        "depends_on": []
    },
    {
        "phase": 2,
        "name": "Graph Linkages",
        "description": "Add graph_links array. b00t task link creates edges. trace_path works on tasks.",
        "effort": "ch0nky",
        "depends_on": ["phase-1"]
    },
    {
        "phase": 3,
        "name": "Auto-Unblock",
        "description": "unblock_conditions evaluated after task done. Auto-transitions blocked→pending.",
        "effort": "sm0l",
        "depends_on": ["phase-2"]
    },
    {
        "phase": 4,
        "name": "Risk Scoring",
        "description": "risk_score computed from author/hotness/complexity/novelty. review_policy auto-assigned.",
        "effort": "ch0nky",
        "depends_on": ["phase-2"]
    },
    {
        "phase": 5,
        "name": "Operator Triage",
        "description": "b00t task triage, graph, batch commands. just sugar recipes.",
        "effort": "sm0l",
        "depends_on": ["phase-3", "phase-4"]
    },
    {
        "phase": 6,
        "name": "Signal Detection",
        "description": "Automated hallucination/eureka indicators. Links to codebase-memory for verification.",
        "effort": "frontier",
        "depends_on": ["phase-4"]
    }
]

# ── Success Metrics ──────────────────────────────────────────────────────────

[metrics]
targets = [
    "Task triage time: operator can assess 10 tasks in <30 seconds",
    "Hallucination catch rate: auto-detect >60% of hallucinated API calls",
    "Eureka promotion rate: <5% false positive on eureka flagging",
    "Dependency chain visibility: any task's full block chain visible in 1 command",
    "Checklist completion: verification items auto-checked against graph state",
]

