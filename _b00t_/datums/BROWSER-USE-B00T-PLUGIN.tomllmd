# BROWSER-USE-B00T-PLUGIN: DOM enrichment + CDP bridge for agent-driven browser automation
# 🤓 Stable [data-b00t-*] selectors survive CSS redesigns.
#    chrome.debugger API enables full CDP control without external relay.

[b00t.schema]
version   = "1"
type      = "capability"
type_tags = ["browser", "rpa", "cdp", "dom-enrichment", "screenshot", "plugin", "ch0nky"]

[datum]
id          = "BROWSER-USE-B00T-PLUGIN"
name        = "browser-use-b00t-plugin"
status      = "active"
tier        = "ch0nky"
description = "Chrome extension + CDP bridge for DOM enrichment, screen capture, and RPA command palette"

[architecture]
wsl_host    = "auto-detected via ip route show default"
windows_ip  = "172.30.64.1 (WSL2 gateway)"
cdp_port    = 9222
relay_port  = 9223  # Python relay on Windows (0.0.0.0:9223 → 127.0.0.1:9222)
relay_type  = "Python socket forwarder (C:\\temp\\cdp-relay.py)"
chrome_flags = [
  "--remote-debugging-port=9222",
  "--remote-allow-origins=*",
  "--load-extension=C:\\b00t\\browser-plugin",
  "--user-data-dir=C:\\b00t\\chrome-debug",
]

[dom_enrichment]
injected_attributes = [
  "data-b00t-type  — element category (button, input, link, form, nav, image, heading, frame)",
  "data-b00t-role  — semantic role (submit, text, navigation, checkbox, select, modal, media)",
  "data-b00t-label — stable label (aria-label > placeholder > textcontent)",
  "data-b00t-id    — element id if present",
  "data-b00t-name  — form field name if present",
]
selector_stability = "Fragile: .search-box__input--v2  →  Stable: [data-b00t-type='input'][data-b00t-label='Search']"
spa_support       = "MutationObserver watches for dynamically added elements"

[cdp_bridge]
method      = "chrome.debugger API (attach to tab)"
capabilities = [
  "Runtime.evaluate — execute arbitrary JS",
  "Page.captureScreenshot — full-page + visible screenshots",
  "Page.getLayoutMetrics — page dimensions",
  "Emulation.setDeviceMetricsOverride — viewport resize",
  "Page.enable / Runtime.enable — domain activation",
]

[screen_capture]
visible_tab  = "chrome.tabs.captureVisibleTab (instant)"
full_page    = "CDP Page.captureScreenshot + viewport resize to content dimensions"

[command_palette]
interface     = "Chrome sidePanel (panel.html)"
filter        = "fzf-like fuzzy search on type"
script_curation = "Enter to add, Backspace to remove, Ctrl+Enter to execute"
screenshot_btn   = "Captures visible tab immediately"

[integration_with_b00t_rpa]
relay_channel = "Python TCP relay (0.0.0.0:9223) bridges WSL→Windows"
cli_commands  = [
  "b00t-rpa start              — auto-detect + launch Chrome + TUI",
  "b00t-rpa plugin             — install/update browser plugin",
  "b00t-rpa --url <url>        — navigate headless",
  "b00t-rpa --eval <js>        — execute JS headless",
  "b00t-rpa --url --eval       — navigate then evaluate",
]
tui_controls = "j/k navigate, Enter add, Backspace remove, Esc exit, type to filter"

[[related]]
datum = "B00T-FINETUNE-PIPELINE"
note  = "Fine-tuned ch0nky subagent uses this plugin for browser-based eval"

[[related]]
datum = "PRD-ARCH-005-MBSE-VISUALIZATION"
note  = "Plugin screenshots feed isometric visualization pipeline"

[[related]]
datum = "PRD-ARCH-009-OTEL-SESSION-METRICS"
note  = "CDP telemetry → session metrics for agent OODA loop"

# b00t:map v1
# summary: Chrome extension + CDP bridge for DOM enrichment, screen capture, and RPA command palette
# tags: browser, rpa, cdp, dom-enrichment, screenshot, plugin, ch0nky
# tier: ch0nky
# cmds: b00t-rpa plugin, b00t-rpa start, b00t-rpa --url <url>
# complexity: 6
