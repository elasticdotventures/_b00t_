{
  "name": "{{ agent_name }}",
  "description": "{{ agent_description }}",
  "prompt": null,
  "mcpServers": {
    {%- for server in mcp_servers %}
    "{{ server }}": {}{{ "," if not loop.last else "" }}
    {%- endfor %}
  },
  "tools": {{ tools | tojson }},
  "resources": [
    {%- for resource in resources %}
    "{{ resource }}"{{ "," if not loop.last else "" }}
    {%- endfor %}
  ],
  "toolsSettings": {
    "namespace": {
      "enabled": {{ namespace_enabled | lower }},
      "skills": {{ skills | tojson }},
      "isolation": "{{ isolation_mode }}"
    }
  },
  "model": {{ model | tojson }}
}
