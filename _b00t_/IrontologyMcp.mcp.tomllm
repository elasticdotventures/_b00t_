[b00t]
# 🤓 irontology-mcp: semantic graph/RAG over codebase + ontology
# 🤓 Co-evolved with b00t; PromptExecution/irontology-mcp accepts b00t-aligned PRs
# 🤓 vendor/irontology-mcp is a git submodule (branch: feat/elasticdotventures/_b00t_)
name = "IrontologyMcp"
type = "mcp_server"
transport = "stdio"
hint = "Semantic graph/RAG over codebase + ontology; tools: repo.search, repo.read_symbol, ontology.list_classes, ontology.related_resources"

[b00t.source]
# 🤓 changes pushed to PromptExecution/irontology-mcp on feat/elasticdotventures/_b00t_
repo = "git@github.com:PromptExecution/irontology-mcp.git"
branch = "feat/elasticdotventures/_b00t_"
submodule_path = "vendor/irontology-mcp"

[b00t.build]
# 🤓 binary name is irontology-mcp (bin target in crates/mcp-server/Cargo.toml)
command = "cargo build --release --manifest-path vendor/irontology-mcp/Cargo.toml"
binary = "vendor/irontology-mcp/target/release/irontology-mcp"
status = "builds_and_responds"
# 🤓 smoke test: echo initialize | ./irontology-mcp → JSON-RPC 200 with tools capability

[b00t.mcp]
# 🤓 stdio transport — binary builds; register with: b00t mcp install irontology claudecode
name = "irontology"
type = "stdio"
command = "vendor/irontology-mcp/target/release/irontology-mcp"
args = []
env = { NEUMANN_DATA_DIR = "~/.b00t/neumann" }

[b00t.tools]
# repo.search              — 4-way fusion search (vector 0.35, graph 0.30, lexical 0.20, ontology 0.15)
# repo.read_symbol         — read symbol definition by name/path
# ontology.list_classes    — list ontology classes from NeumannStore
# ontology.related_resources — RDF graph traversal of related entities

[b00t.roadmap]
# Phase 1 (#262): sled persistence for NeumannStore (data survives restart)
# Phase 2 (#263): real VectorBackend via llama-server /v1/embeddings
# Phase 3 (#261): wire b00t grok (digest/ask/learn) to irontology backend

[b00t.domain]
# 🤓 primary consumer: b00t hive — indexes datum TOMLs as ontology nodes
# 🤓 secondary: semantic queries over arbitrary codebases
status = "functional_synthetic_backend"
crates = ["codegraph", "domain", "dsl", "indexer", "mcp-server", "retrieval", "storage-neumann"]

[[b00t.usage]]
description = "Build irontology-mcp binary from submodule"
command = "cargo build --release --manifest-path vendor/irontology-mcp/Cargo.toml"

[[b00t.usage]]
description = "Install to Claude Code"
command = "b00t mcp install irontology claudecode"

[[b00t.usage]]
description = "Smoke test binary"
command = "echo '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0.0.1\"}}}' | vendor/irontology-mcp/target/debug/irontology-mcp"

# b00t:map v1
# summary: irontology-mcp — semantic graph/RAG MCP server (binary working, synthetic backend)
# tags: mcp, semantic, ontology, rag, codegraph, irontology, grok
# tier: frontier
# cmds: cargo build --release --manifest-path vendor/irontology-mcp/Cargo.toml
# complexity: 8
# prereqs: vendor/irontology-mcp submodule (git submodule update --init vendor/irontology-mcp)
