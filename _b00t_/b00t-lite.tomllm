[b00t]
# 🤓 b00t-lite.tomllm is the install datum for b00t-lite.sh bootstrap
# 🤓 b00t-lite.sh reads this file using python3.11+ tomllib (no deps) or toml-cli fallback
# 🤓 .tomllm IS valid TOML — # is standard TOML comment; no stripping needed
# 🤓 OS keys: linux_debian, linux_ubuntu, linux_arch, linux_fedora, linux_alpine, darwin, linux_unknown
# 💡例 ./b00t-lite.sh
# 💡例 ./b00t-lite.sh --dry-run
# 💡例 sudo B00T_DIR=$PWD ./b00t-lite.sh
name = "b00t-lite"
type = "install"
hint = "Minimal bootstrap — reads OS-specific install commands from datum, no hard-coded distro logic"

# ── Shared: systemd unit files (distro-agnostic) ─────────────────────────────
[b00t.install]
# 🤓 systemd_cmds run regardless of distro; sudo path gets _prompt_timeout, user path runs direct
# 🤓 add new OS keys below — b00t-lite.sh falls back to linux_unknown if key not found
systemd_cmds = [
    "mkdir -p /usr/lib/systemd/user",
    "cp -v ${B00T_DIR:-.}/.config/systemd/user/b00t@.service /usr/lib/systemd/user/b00t@.service",
    "systemctl daemon-reload",
]

# ── Debian / Ubuntu ───────────────────────────────────────────────────────────
[b00t.install.linux_debian]
# 🤓 apt-get goes in sudo_cmds; cargo/uv go in user_cmds
sudo_cmds = [
    "apt-get update -q",
    "apt-get install -y curl build-essential pkg-config libssl-dev fzf bat moreutils fd-find bc jq python3 python3-argcomplete",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "command -v dotenv  >/dev/null 2>&1 || uv tool install python-dotenv[cli]",
    "command -v dotenvy >/dev/null 2>&1 || cargo install dotenvy --features cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ubuntu is debian-family; same commands
[b00t.install.linux_ubuntu]
# 🤓 ubuntu uses same apt-get as debian; inherit by duplicating (TOML has no inheritance)
sudo_cmds = [
    "apt-get update -q",
    "apt-get install -y curl build-essential pkg-config libssl-dev fzf bat moreutils fd-find bc jq python3 python3-argcomplete",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "command -v dotenv  >/dev/null 2>&1 || uv tool install python-dotenv[cli]",
    "command -v dotenvy >/dev/null 2>&1 || cargo install dotenvy --features cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ── Arch Linux ────────────────────────────────────────────────────────────────
[b00t.install.linux_arch]
sudo_cmds = [
    "pacman -Sy --noconfirm base-devel curl openssl fzf bat moreutils fd bc jq python",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ── Fedora / RHEL / CentOS ────────────────────────────────────────────────────
[b00t.install.linux_fedora]
sudo_cmds = [
    "dnf install -y curl gcc openssl-devel pkg-config fzf bat moreutils fd-find bc jq python3",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ── Alpine Linux ──────────────────────────────────────────────────────────────
[b00t.install.linux_alpine]
# 🤓 alpine uses apk; musl libc — cargo cross-compile may need musl-dev
sudo_cmds = [
    "apk add --no-cache curl bash build-base openssl-dev pkgconfig fzf jq python3",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ── macOS ─────────────────────────────────────────────────────────────────────
[b00t.install.darwin]
# 🤓 brew install goes in sudo_cmds (requires interactive auth, not root per se)
# 🤓 on macOS, sudo_cmds uses _prompt_timeout because brew can be slow/interactive
sudo_cmds = [
    "command -v brew >/dev/null 2>&1 || /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"",
    "brew install curl openssl fzf bat moreutils fd bc jq python3",
]
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

# ── Fallback ──────────────────────────────────────────────────────────────────
[b00t.install.linux_unknown]
# 🤓 unknown distro — skip package manager, attempt cargo-only install
sudo_cmds = []
user_cmds = [
    "command -v rustup >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "export PATH=\"$HOME/.cargo/bin:$PATH\"",
    "command -v toml    >/dev/null 2>&1 || cargo install toml-cli",
    "cargo install --path ${B00T_DIR:-.}/b00t-mcp --force",
    "cargo install --path ${B00T_DIR:-.}/b00t-cli --force",
]

[[b00t.usage]]
description = "Bootstrap on current OS (dry-run first)"
command = "./b00t-lite.sh --dry-run"

[[b00t.usage]]
description = "Bootstrap with system package install (requires root)"
command = "sudo B00T_DIR=$PWD ./b00t-lite.sh"

[[b00t.usage]]
description = "Bootstrap user-local only (no root)"
command = "./b00t-lite.sh"

# b00t:map v1
# summary: b00t-lite bootstrap datum — OS-specific install commands for b00t-lite.sh
# tags: install, bootstrap, debian, arch, fedora, alpine, darwin, systemd
# tier: sm0l
# cmds: ./b00t-lite.sh --dry-run, sudo B00T_DIR=$PWD ./b00t-lite.sh
# complexity: 3
