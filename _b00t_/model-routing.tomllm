# b00t Model Routing Datum
# @tribal: route by cognitive tier — NEVER use frontier for mechanical work

[b00t]
name = "model-routing"
type = "routing"
hint = "Maps task cognitive tier to optimal model. Prefer local/cheap; escalate only when needed."

# sm0l tier: fast, cheap, deterministic tasks
[tiers.sm0l]
description = "Tests, lint, classify, route, grep, format"
models = ["claude-haiku-4-5-20251001", "qwen-2.5-3b-local"]
output_contract = "PASS or FAIL: <name> <5-line excerpt>"
max_tokens = 1024

# ch0nky tier: implementation, refactor, debug
[tiers.ch0nky]
description = "Write/refactor code, debug, multi-file review, implement skills"
models = ["qwen3-coder-local", "claude-sonnet-4-6"]
# @tribal: qwen3-coder-local needs b00t hive check first — 20GB VRAM on RTX 3090
output_contract = "diff + test result"
max_tokens = 8192

# frontier tier: architecture, security, novel design
[tiers.frontier]
description = "Architecture, security, planning, novel design, ambiguous requirements"
models = ["claude-opus-4-6", "claude-sonnet-4-6"]
output_contract = "structured decision with rationale"
max_tokens = 16384

# task → tier mapping
[task_routing]
tests = "sm0l"
lint = "sm0l"
classify = "sm0l"
route = "sm0l"
grep = "sm0l"
implement = "ch0nky"
refactor = "ch0nky"
debug = "ch0nky"
review = "ch0nky"
translate = "ch0nky"
architecture = "frontier"
security = "frontier"
planning = "frontier"
design = "frontier"

# b00t:map v1
# summary: cognitive-tier model router for b00t agents
# tags: model, routing, ai, tiers, sm0l, ch0nky, frontier
# tier: sm0l
# cmds: b00t learn model-routing
# complexity: 2
