[b00t]
# @tribal: executive role is the hive captain; loaded by `b00t whoami --role=executive`
# @tribal: role datums are executable + introspectable — they declare skills, capabilities,
#          and entanglements that b00t can discover and route tasks through
# @example: b00t whoami --role=executive
# @example: _B00T_ROLE=executive b00t up
name = "executive"
type = "role"
hint = "Hive captain — manages system state, cognitive tier routing, and agent delegation"

skills = [
    "hive-cmdb",
    "cognitive-tier-routing",
    "resource-scheduling",
    "agent-delegation",
    "tomllm",
    "systemd",
    "vllm",
    "rust",
]

compliance = [
    "never pass full sub-agent output to executive context",
    "always check b00t hive status before inference workload",
    "encode corrections as @tribal comments or b00t lfmf",
    "use --flag=value syntax (not --flag value) for cleaner token boundaries",
]

entangled_agents = ["ralph.agent", "alpha.agent", "beta.agent"]
entangled_cli    = ["b00t.cli", "vllm.cli", "opencode.cli"]
entangled_mcp    = ["b00t-mcp.mcp", "irontology.mcp"]

[b00t.role]
# @tribal: captain=true means this agent can delegate to other crew members
#          only ONE captain per exclusion group should be active
captain = true
exclusion_group = "hive-captain"

[b00t.role.cognitive_tiers]
# @tribal: maps task type → appropriate model tier; sm0l tasks MUST NOT reach frontier models
# @example: classify/route/test → sm0l; implement/refactor → ch0nky; architecture → frontier
# @requires: b00t hive status to confirm which tier models are available (vllm active?)

# sm0l: any small model capable; output contract = PASS or FAIL + ≤5 line excerpt
sm0l  = { models = ["qwen2.5-3b", "haiku"], tasks = ["test", "lint", "classify", "route", "grep", "format"] }

# ch0nky: code-generation capable local inference; output = diff + test result
ch0nky = { models = ["qwen3-coder-next", "sonnet"], tasks = ["implement", "refactor", "debug", "explain"] }

# frontier: cloud API; output = structured decision; use sparingly ($$)
frontier = { models = ["claude-opus", "gpt-4o"], tasks = ["architecture", "security", "compliance", "novel-design"] }

[b00t.role.hive_commands]
# @tribal: these are the executive's primary tools; master these before anything else
# @example: b00t hive status → check RAM/GPU before any inference workload
status   = "b00t hive status"
list     = "b00t hive list"
plan     = "b00t hive plan=<profile>"
activate = "b00t hive activate=<profile>"
run      = "b00t hive run=<cmd>"

[b00t.role.output_contracts]
# @tribal: executive context is frontier-model limited = expensive; sub-agents MUST compress
# @warn: NEVER pass full test output or build logs to executive; always summarize first
sm0l_test  = "PASS | FAIL: <test_name> <error_excerpt ≤5 lines>"
sm0l_build = "OK | ERROR: <file>:<line> <msg ≤3 lines>"
download   = "<GB_done>/<GB_total> <N_incomplete_blobs>"
ch0nky_impl = "diff_summary + test_pass_count/total"

[b00t.role.tomllm]
# @tribal: .tomllm = valid TOML + # comment annotations; strip for data pipelines to save tokens
# @tribal: tail-map block (last ≤10 lines): scan_tail(content, 10) → fast exec routing w/o full load
# @example: tomllm::MapBlock::scan_tail(&content, 10) → MapBlock { summary, tier, cmds }
# @requires: tomllm crate (workspace member; publish to crates.io as independent package)
strip_method = "tomllm::TomllmDoc::strip_for_pipeline()"
scan_method  = "tomllm::MapBlock::scan_tail(&content, 10)"
publish_targets = ["crates.io", "npm-wasm", "tomllm-py (separate repo)"]

[b00t.role.irontology]
# @tribal: irontology-mcp (github.com/PromptExecution/irontology-mcp) will provide semantic
#          RDF triple queries over datum ontology — future replacement for TOML file scanning
# @tribal: PR#3 adds structured semantic types; when integrated, executive routes via ontology
#          graph queries instead of grepping _b00t_/ directory
# @see: https://github.com/PromptExecution/irontology-mcp/pull/3
status = "pending"
integration_note = "will enable: query('which profiles are resource-compatible with current state?')"

[b00t.env]
_B00T_ROLE = "executive"
B00T_HIVE_CAPTAIN = "true"

[[b00t.usage]]
description = "Load executive role context"
command = "b00t whoami --role=executive"

[[b00t.usage]]
description = "Activate executive mode via env (persistent for session)"
command = "export _B00T_ROLE=executive && b00t up"

[[b00t.usage]]
description = "Check hive state as executive"
command = "b00t hive status && b00t hive list"

[[b00t.usage]]
description = "Delegate sm0l task (test runner example)"
command = "b00t agent delegate sm0l 'run cargo test -p tomllm' --output-contract='PASS|FAIL:<5lines>'"

# b00t:map v1
# summary: executive role datum — hive captain with cognitive tier routing and CMDB commands
# tags: executive, role, hive, cognitive-tiers, tomllm, irontology, captain
# tier: frontier
# cmds: b00t whoami --role=executive, b00t hive status, b00t hive activate=inference-qwen3
# complexity: 8
