[b00t]
# 🤓 HuggingFace official MCP server — hub search, model/dataset/space ops via MCP
# 🤓 Access: https://huggingface.co/settings/mcp — requires HF_TOKEN env var
# 🤓 Use for: model discovery, dataset search, space info, paper lookup
# 🤓 Tool use: search-models, get-model-info, search-datasets, get-dataset-info, etc.
name = "HuggingfaceMcp"
type = "mcp_server"
hint = "HuggingFace Hub MCP — model/dataset/space/paper search and info via SSE"

[b00t.mcp]
name = "huggingface"
type = "httpstream"
url = "https://huggingface.co/mcp"
# 🤓 auth: Bearer token from HF_TOKEN env var; set in ~/.config/b00t/credentials.env
# 🤓 headers: {"Authorization": "Bearer $HF_TOKEN"}

[b00t.tools]
# 🤓 Available tools (HF Hub MCP): https://huggingface.co/settings/mcp
search_models = "Search models by query, tags, author, pipeline_tag; returns model cards"
get_model_info = "Full model card + metadata for a specific model ID"
search_datasets = "Search datasets with filters"
get_dataset_info = "Dataset card + metadata"
search_spaces = "Search HF Spaces (demos, apps)"
get_space_info = "Space info + links"
get_paper_info = "ArXiv paper info + HF implementations"
get_daily_papers = "Curated daily papers from HF"
search_collections = "Search HF collections"

[b00t.install]
# 🤓 Install HF MCP to Claude Code (requires HF_TOKEN)
claude_code = "b00t mcp install HuggingfaceMcp claudecode"
vscode = "b00t mcp install HuggingfaceMcp vscode"

[[b00t.usage]]
description = "Add HF MCP to Claude Code with HF token"
command = """b00t-cli mcp add --dwiw '{
  "mcpServers": {
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {"Authorization": "Bearer ${HF_TOKEN}"}
    }
  }
}'"""

[[b00t.usage]]
description = "Find alternative models to Qwen3-Coder-Next for vLLM testing"
command = """# Use HF MCP search-models tool:
# query: "code model GGUF 7B", tags: ["gguf"], pipeline_tag: "text-generation"
# Or search for AWQ/GPTQ models that vLLM supports natively (no patches)"""

[[b00t.usage]]
description = "Find vLLM-compatible quantized code models (AWQ, GPTQ)"
hint = """search-models: query="qwen2.5 coder AWQ", tags=["awq"]
           → Qwen/Qwen2.5-Coder-7B-Instruct-AWQ (fits in 24GB, no patches)
           → TheBloke/Qwen2.5-Coder-14B-Instruct-AWQ (14B AWQ ~10GB)
           → Qwen/Qwen2.5-Coder-32B-Instruct-AWQ (32B AWQ ~20GB, fits in 24GB)"""

# b00t:map v1
# summary: HuggingFace Hub MCP server — model/dataset/space/paper search via SSE
# tags: huggingface, mcp, model-search, hub, ai
# tier: frontier
# cmds: b00t mcp install HuggingfaceMcp claudecode
# complexity: 3
# prereqs: HF_TOKEN env var; internet access
