[Unit]
Description=Valkey (Redis-compatible) for b00t agent coordination
After=network-online.target

[Container]
ContainerName=valkey
Image=docker.io/valkey/valkey:8-alpine
# LAN-reachable (all interfaces) per operator choice 2026-10-07. NO AUTH —
# add requirepass (podman secret) before exposing beyond the trusted LAN.
PublishPort=0.0.0.0:6379:6379
# Persistence: pre-existing named volume valkey_data (survives container
# replacement and `systemctl --user restart`). AOF everysec + RDB snapshots.
Volume=valkey_data:/data
# Required by the b00t-limits OCI hook (shared node). A plain container has no
# uncapped infra container, so no b00t.unlimited opt-out is needed.
Memory=512m
# noeviction: coordination state must never be silently evicted; maxmemory sits
# below the cap so valkey returns errors before the kernel OOM-kills it.
Exec=valkey-server --appendonly yes --appendfsync everysec --save "60 1" --save "300 100" --maxmemory 384mb --maxmemory-policy noeviction --protected-mode no --dir /data
HealthCmd=valkey-cli ping
HealthInterval=10s
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
