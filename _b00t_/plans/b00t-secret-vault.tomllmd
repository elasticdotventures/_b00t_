# b00t Zero-Trust Secret Management — Key Vault Proxy
# 🤓 No raw API keys in files, env vars, or datums. Ever.
# System keyring stores secrets. b00t-server is the sole vault. Consumers get opaque tokens.

[b00t]
name = "b00t-secret-vault"
type = "plan"
hint = "Zero-trust key management — OS keyring storage, token-based access, full audit trail"

# ──────────── Current Risk ────────────

[[soul.risks]]
name = "env var leak"
detail = "OPENAI_API_KEY in shell env could be dumped, logged, or committed to dotenv datum"
severity = "critical"

[[soul.risks]]
name = "datum exposure"
detail = "Any .toml datum with 'api_key_env = OPENAI_API_KEY' could expose the var name, tempting inline values"
severity = "high"

[[soul.risks]]
name = "consumer over-privilege"
detail = "rust-doc gets full OpenAI key — can rack up costs on any endpoint, not just embeddings"
severity = "medium"

[[soul.risks]]
name = "bootstrap script"
detail = "scripts/bootstrap-session.sh sets OPENAI_API_KEY in shell — visible to all child processes"
severity = "high"

# ──────────── Zero-Trust Architecture ────────────

[soul.architecture]
principle = "Never store raw keys in files, env vars, or datums. Only in OS keyring."
flow = """
  1. Operator:  'b00t server key set --provider openai'  → key stored in OS keyring
  2. Server start: b00t-mcp reads key from keyring into in-memory state
  3. Consumer:   'b00t server key create --consumer rust-doc --scopes embeddings'
                 → receives b00t-sk-* token (opaque — reveals nothing)
  4. Consumer use: curl -H 'Authorization: Bearer b00t-sk-...' :5273/v1/embeddings
  5. Proxy:      validates b00t-sk-* token, checks scopes, injects real upstream key
  6. Audit:      Spotlight logs every key injection + use
"""

# ──────────── Key Storage — OS Keyring ────────────

[soul.keyring]
provider = "OS-native keyring (Secret Service / Keychain / Credential Manager)"
rust_crate = "keyring = \"3\"  (or secret-service on Linux)"
already_in_b00t = "b00t-c0re-lib/src/b00t_config.rs:383 — KeyringBackend enum exists but unused"

# Key naming convention in keyring
pattern = "b00t/upstream/{provider}"
entries = [
  "b00t/upstream/openai         → sk-... (OpenAI API key)",
  "b00t/upstream/anthropic      → sk-ant-... (Anthropic API key)",
  "b00t/upstream/openrouter     → sk-or-... (OpenRouter API key)",
  "b00t/upstream/cloudflare-r2   → R2 access key + secret (JSON)",
]

# CLI commands
[[soul.cli]]
command = "b00t server key set --provider openai"
description = "Reads key from stdin or prompt, writes to OS keyring"
example = "b00t server key set --provider openai < /secure/path/key.txt"

[[soul.cli]]
command = "b00t server key set --provider openai --interactive"
description = "Prompts securely (no echo, no shell history)"

[[soul.cli]]
command = "b00t server key unset --provider openai"
description = "Remove key from keyring"

# ──────────── Token-Based Access ────────────

[soul.tokens]
format = "b00t-sk-{uuid} (opaque, reveals nothing)"
storage = "in-memory only (server process RAM). Lost on restart — regenerate via CLI."
scopes = ["chat", "embeddings", "models", "finetune"]
default_scope = "all endpoints"

# b00t server key create with scoping
create_example = '''
b00t server key create \
  --consumer rust-doc \
  --scopes embeddings,models \
  --max-tokens-per-day 1000000 \
  --max-cost-per-day "0.50"
'''

# ACL integration — scopes enforced at proxy middleware
scope_checks = '''
# server_llm.rs middleware:
#   embeddings endpoint → requires "embeddings" scope
#   chat/completions   → requires "chat" scope
#   models              → requires "models" scope
#   unknown scope       → 403 Forbidden
'''

# ──────────── Audit Trail ────────────

[soul.audit]
log_file = "~/.b00t/vault-audit.jsonl"
events = [
  "key_set: operator set upstream key for provider X (no value logged)",
  "key_unset: operator removed key for provider X",
  "token_created: consumer X received token with scopes [A,B]",
  "token_revoked: consumer X token revoked",
  "token_used: consumer X called /v1/Y → allowed/denied, latency_ms",
  "token_quota_exceeded: consumer X hit daily limit",
]

# ──────────── Implementation Plan ────────────

[[soul.phases]]
name = "Phase 1: OS Keyring backend"
work = """
- b00t-c0re-lib/src/keyring_store.rs (NEW): KeyringStore struct
  - set(provider, key), get(provider) -> Option<String>, delete(provider)
  - Uses 'keyring' crate (cross-platform)
  - Fallback: encrypted file with OS-protected permissions (0600, chown)
- b00t-cli/src/commands/server.rs: add 'key set --provider X [--interactive]'
- b00t-cli/src/commands/server.rs: add 'key unset --provider X'
"""
loc_est = 120
depends = "Add keyring = \"3\" to b00t-c0re-lib/Cargo.toml"

[[soul.phases]]
name = "Phase 2: Server-side key loading"
work = """
- server_llm.rs: LlmState loads keys from KeyringStore at startup
  - resolve_upstream() checks keyring FIRST (before env vars)
  - Env vars become fallback, not primary
- server_llm.rs: drop upstream_key from struct — resolve at request time
  (prevents key sitting in memory longer than needed)
"""
loc_est = 40

[[soul.phases]]
name = "Phase 3: Scoped tokens"
work = """
- server_llm.rs: KeyEntry gains scopes: Vec<String>, quotas
- server_llm.rs: require_api_key middleware checks scope match
- b00t-cli server key create: add --scopes, --max-tokens-per-day
- b00t-cli server key list: show scopes, usage stats
"""
loc_est = 60

[[soul.phases]]
name = "Phase 4: Audit logging"
work = """
- server_llm.rs: emit vault-audit.jsonl events
- b00t-cli server key audit: query audit log
- b00t-cli server key revoke: invalidate token immediately
"""
loc_est = 50

[[soul.phases]]
name = "Phase 5: Bootstrap script update"
work = """
- scripts/bootstrap-session.sh: remove OPENAI_API_KEY export
- Replace with: b00t server key create --consumer rust-doc
  → key injection happens at proxy time, not in shell env
- Consumer env only needs: OPENAI_BASE_URL=http://localhost:5273/v1
"""
loc_est = 10

# ──────────── Before/After ────────────

[[soul.comparison]]
before = "OPENAI_API_KEY=sk-abc123  # sits in shell env, dumpable, committable"
after = "b00t server key set --provider openai < key.txt  # → OS keyring"
before_consumer = "export OPENAI_API_KEY=sk-abc123  # raw key exposed"
after_consumer = "export OPENAI_API_KEY=b00t-sk-...  # opaque token, scoped, audited"

# b00t:map v1
# summary: Zero-trust secret management — OS keyring storage, token-based access, scoped consumers, full audit
# tags: security, zero-trust, keyring, secrets, vault, token, audit, acl
# tier: frontier
# cmds: b00t server key set --provider X, b00t server key create --consumer X --scopes A,B
# complexity: 9
