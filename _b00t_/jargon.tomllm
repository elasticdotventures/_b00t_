[b00t]
# 🤓 jargon datum — canonical registry of .tomllm annotation filters & b00t emoji jargon
# 🤓 emoji + UTF-8 漢語 ideoglyphs are grep-friendly semantic markers in .tomllm files
# 💡例 b00t learn jargon
# 💡例 grep "# 🤓" _b00t_/*.tomllm  → list all tribal knowledge hints
name = "jargon"
type = "config"
hint = "Emoji + .tomllm annotation filter registry — the b00t tribal lexicon"

[b00t.annotations.g0spell]
# 🤓 g0spell — multi-variant acronym expansion registry (ZIP+4 for b00t terms)
# Each term has extended variants for specificity (e.g., Yei → YeiHive, YeiAgent, YeiOrg)
# g0spell is closely related to jargon but focuses on acronym expansions, not emoji

# Yei — "You everybody & I" (你我众一 — you, me, everyone as one)
yei           = "Yei (你我众一) — hive collective; You + Everybody + I"
yei_hive      = "YeiHive — the hive organization/infrastructure collectively maintained"
yei_agent     = "YeiAgent — any agent participating in the b00t hive"
yei_org        = "YeiOrg — PromptExecution, the AI engineering firm"

# b00t — bootstrap / evolutionary neuromorphic agentic developer interface
b00t          = "b00t — bootstrap; the framework; also: b00t-cli, b00t-mcp"
b00t_g0spell  = "b00t g0spell — the operating protocol; canonical acronym expansion registry"
b00t_gospel   = "🦨 legacy term; renamed to b00t g0spell in 2026-05"

# LFMF — Learn From My Failure
lfmf          = "LFMF — Learn From My Failure; lessons from mistakes codified into datums"
lfmf_datum    = "LFMF datum — the abstract lesson stored as a b00t datum"
lfmf_abstract = "LFMF abstract — generic lesson (not tool-specific) suitable for future learn"

# MCP — Model Context Protocol
mcp           = "MCP — Model Context Protocol; tool interface standard"
mcp_stdio     = "MCP stdio — subprocess lifecycle transport (no network port)"
mcp_http      = "MCP http/sse — HTTP + Server-Sent Events transport"
mcp_sse       = "MCP SSE — Server-Sent Events for streaming"

# SDD — Specification Driven Development
sdd           = "SDD — Specification Driven Development; replaces PRD, builds confidence over iterations"
prd           = "PRD — Product Requirements Document; deprecated in favor of SDD"

# GGG — Go Get Git
ggg           = "GGG — Go Get Git; agent behavior pattern: first discover tool is git, attempt b00t learn git"

# DRY — Don't Repeat Yourself
dry           = "DRY — Don't Repeat Yourself"
nrtw          = "NRtW — Never Reinvent the Wheel"

# TOMLLM — TOML + Markdown hybrid markup
tomllm        = "TOMLLM — valid TOML + enriched # comment conventions"
tomllmd       = "TOMLLMD — superset of TOMLLM with diagram/DSL/structured-markdown semantics"

# K0MMAND3R — Commander (b00t dispatch/coordination)
k0mmand3r     = "K0MMAND3R — Commander; dispatch/coordination layer for b00t agents"

# CC## — Confidence Class (AgentR voting)
cc_vote       = "CC## — Confidence Class vote; 00-99 preference scale for AgentR retrospective votes"
# 🧠 cognitive soul — reserved token for consciousness-level agent interfaces
cognitive_soul = "🧠 RESERVED — cognitive soul interface token; not for general use"

# 🤓 .tomllm annotation prefixes are stripped by tomllm::TomllmDoc::strip_for_pipeline()
#          only meaningful content reaches the data pipeline; annotations are for agents/humans
# Format: `# <filter> <content>` — all annotation lines begin with `#` (valid TOML comment)

[b00t.annotations.filters]
# 🤓 melvin — non-obvious tribal knowledge; do NOT remove without 3x TRIZ justification
# Usage: # 🤓 <context-specific insight that would take hours to rediscover>
# 漢字 suffix is OPTIONAL — adds specificity when needed; emoji alone is valid
melvin        = "🤓"
melvin_hanyu  = "🤓 (书呆子 shūdāizi) — tribal wisdom; single 🤓 allowed per session"

# Annotation syntax: `# <emoji>[漢字] <content>`
# 漢字 suffix: 1-2 chars for sub-context; emoji alone = unqualified form
# grep patterns: "# 🤓", "# 💡例", "# ⚠️需", "# 🔗参", "# 🚩"

# 🤓   tribal knowledge    (no suffix = general wisdom)
# 🤓知  tribal: knowledge-type     知 = zhī = know
# 🤓法  tribal: method/approach    法 = fǎ = method
tribal        = "🤓"

# 💡例  example / usage instance   例 = lì = example
# 💡法  example: method/recipe     法 = fǎ = method
example       = "💡例"

# ⚠️需  prerequisite / requirement  需 = xū = need
# ⚠️戒  caution / precept           戒 = jiè = precaution
requires      = "⚠️需"

# 🔗参  see also / reference        参 = cān = consult
see           = "🔗参"

# 🚩    warning / security flag     (no suffix; 红旗 hóngqí = red flag)
warn          = "🚩"

[b00t.annotations.emoji_jargon]
# 🚩 cybersec flag — unintentional data disclosure risk
cybersec_flag = "🚩 (红旗 hóngqí) — security concern; potential data disclosure"

# 🦨 skunk — cry for help: something didn't work / required a workaround
# 🤓 NOT a rename marker — 🦨 means "this hurt, here's the workaround, don't fix it yet"
# 💡例 # 🦨 pip install fails in venv — use uv pip install instead (see issue #42)
skunk         = "🦨 (臭鼬 chòuyòu) — cry for help; didn't work as expected, workaround applied"

# 💩 anti-pattern — known bad practice; do NOT replicate this pattern
# 💡例 # 💩 calling pip install directly bypasses venv isolation
antipattern   = "💩 (臭 chòu) — anti-pattern; do NOT copy this"

# 🐛 known bug — filed or noted defect, not yet fixed
# 💡例 # 🐛 version detection fails on arm64 when brew is in /opt/homebrew
bug           = "🐛 (虫子 chóngzi) — known bug; do not paper over, fix the root cause"

# ⚠️ warning
warn          = "⚠️ (警告 jǐnggào) — caveat; read before proceeding"
# ✅ / ❌ pass/fail
pass          = "✅ (通过 tōngguò) — capability check passed"
fail          = "❌ (失败 shībài) — capability missing or mismatch"
# 🍰 cake — aligned behavior reward
cake          = "🍰 (蛋糕 dàngāo) — reward for aligned execution"
cake_shortcode = ":cake: — ASCII shortcode alias for 🍰; executive-only shorthand until generalized"
# 🥾 boot
boot          = "🥾 b00t — the framework itself; also: bootstrap"

[b00t.annotations.cognitive_tiers]
# 🧠 cognitive soul interface — reserved token for consciousness-level agent interfaces
# Emoji shorthand for cognitive tier routing in executive context
sm0l          = "🐭 (小 xiǎo) — any small model; classify/route/test"
ch0nky        = "🐻 (胖 pàng) — code-gen capable local model"
frontier      = "🚀 (前沿 qiányán) — cloud API frontier model; expensive"

[b00t.annotations.ooda_idiom]
# OODA — first-class b00t goal-loop idiom
# Observe collects evidence; Orient maps it into ontology/capability context;
# Decide selects a deterministic route; Act mutates or dispatches; Review emits validation evidence.
ooda = "OODA — Observe -> Orient -> Decide -> Act; b00t goal-loop idiom for typed capability execution"
observe = "Observe — collect events, datums, resources, code graph, embeddings, telemetry, operator intent"
orient = "Orient — normalize into UFO/SysML categories, retrieve neighbors, validate shapes, select traits"
decide = "Decide — choose recipe, patch dialect, sandbox profile, agent tier, or simulation branch"
act = "Act — execute guarded command, semantic patch, simulation step, or agent dispatch"
review = "Review — b00t extension: emit tests, diffs, JSONL, bouncer PASS/FAIL, dashboard evidence"

[b00t.tomllm_strip_rules]
# 🤓 tomllm::TomllmDoc::strip_for_pipeline() removes lines matching these prefixes
# Stripping annotations before passing to data pipeline saves tokens & avoids leaking tribal context
# 🤓 strip by emoji prefix — suffixed variants (💡例, ⚠️需) match via prefix of base emoji
# tomllm::TomllmDoc::strip_for_pipeline() strips lines WHERE line starts with any of these
strip_line_prefixes = ["# 🤓", "# 💡", "# ⚠️", "# 🔗", "# 🚩"]
# Note: tail-map block (# b00t:map v1 ... ) is preserved by strip_for_pipeline (extracted separately)
# Note: bare emoji prefix match catches all suffixed variants (💡例, 💡法, ⚠️需, ⚠️戒, etc.)
preserve_tail_map   = true

# b00t:map v1
# summary: b00t jargon datum — emoji+annotation filter registry plus first-class OODA idiom for .tomllm tribal lexicon
# tags: jargon, tomllm, emoji, annotations, filters, 漢語, tribal, ooda, idiom
# tier: sm0l
# cmds: b00t learn jargon, rg -n "OODA|ooda" _b00t_/jargon.tomllm
# complexity: 2
