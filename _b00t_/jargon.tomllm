[b00t]
# 🤓 jargon datum — canonical registry of .tomllm annotation filters & b00t emoji jargon
# 🤓 emoji + UTF-8 漢語 ideoglyphs are grep-friendly semantic markers in .tomllm files
# 💡例 b00t learn jargon
# 💡例 grep "# 🤓" _b00t_/*.tomllm  → list all tribal knowledge hints
name = "jargon"
type = "config"
hint = "Emoji + .tomllm annotation filter registry — the b00t tribal lexicon"

[b00t.annotations]
# 🤓 .tomllm annotation prefixes are stripped by tomllm::TomllmDoc::strip_for_pipeline()
#          only meaningful content reaches the data pipeline; annotations are for agents/humans
# Format: `# <filter> <content>` — all annotation lines begin with `#` (valid TOML comment)

[b00t.annotations.filters]
# 🤓 melvin — non-obvious tribal knowledge; do NOT remove without 3x TRIZ justification
# Usage: # 🤓 <context-specific insight that would take hours to rediscover>
# 漢字 suffix is OPTIONAL — adds specificity when needed; emoji alone is valid
melvin        = "🤓"
melvin_hanyu  = "🤓 (书呆子 shūdāizi) — tribal wisdom; single 🤓 allowed per session"

# Annotation syntax: `# <emoji>[漢字] <content>`
# 漢字 suffix: 1-2 chars for sub-context; emoji alone = unqualified form
# grep patterns: "# 🤓", "# 💡例", "# ⚠️需", "# 🔗参", "# 🚩"

# 🤓   tribal knowledge    (no suffix = general wisdom)
# 🤓知  tribal: knowledge-type     知 = zhī = know
# 🤓法  tribal: method/approach    法 = fǎ = method
tribal        = "🤓"

# 💡例  example / usage instance   例 = lì = example
# 💡法  example: method/recipe     法 = fǎ = method
example       = "💡例"

# ⚠️需  prerequisite / requirement  需 = xū = need
# ⚠️戒  caution / precept           戒 = jiè = precaution
requires      = "⚠️需"

# 🔗参  see also / reference        参 = cān = consult
see           = "🔗参"

# 🚩    warning / security flag     (no suffix; 红旗 hóngqí = red flag)
warn          = "🚩"

[b00t.annotations.emoji_jargon]
# 🚩 cybersec flag — unintentional data disclosure risk
cybersec_flag = "🚩 (红旗 hóngqí) — security concern; potential data disclosure"

# 🦨 skunk — cry for help: something didn't work / required a workaround
# 🤓 NOT a rename marker — 🦨 means "this hurt, here's the workaround, don't fix it yet"
# 💡例 # 🦨 pip install fails in venv — use uv pip install instead (see issue #42)
skunk         = "🦨 (臭鼬 chòuyòu) — cry for help; didn't work as expected, workaround applied"

# 💩 anti-pattern — known bad practice; do NOT replicate this pattern
# 💡例 # 💩 calling pip install directly bypasses venv isolation
antipattern   = "💩 (臭 chòu) — anti-pattern; do NOT copy this"

# 🐛 known bug — filed or noted defect, not yet fixed
# 💡例 # 🐛 version detection fails on arm64 when brew is in /opt/homebrew
bug           = "🐛 (虫子 chóngzi) — known bug; do not paper over, fix the root cause"

# ⚠️ warning
warn          = "⚠️ (警告 jǐnggào) — caveat; read before proceeding"
# ✅ / ❌ pass/fail
pass          = "✅ (通过 tōngguò) — capability check passed"
fail          = "❌ (失败 shībài) — capability missing or mismatch"
# 🍰 cake — aligned behavior reward
cake          = "🍰 (蛋糕 dàngāo) — reward for aligned execution"
cake_shortcode = ":cake: — ASCII shortcode alias for 🍰; executive-only shorthand until generalized"
# 🥾 boot
boot          = "🥾 b00t — the framework itself; also: bootstrap"

[b00t.annotations.cognitive_tiers]
# Emoji shorthand for cognitive tier routing in executive context
sm0l          = "🐭 (小 xiǎo) — any small model; classify/route/test"
ch0nky        = "🐻 (胖 pàng) — code-gen capable local model"
frontier      = "🚀 (前沿 qiányán) — cloud API frontier model; expensive"

[b00t.tomllm_strip_rules]
# 🤓 tomllm::TomllmDoc::strip_for_pipeline() removes lines matching these prefixes
# Stripping annotations before passing to data pipeline saves tokens & avoids leaking tribal context
# 🤓 strip by emoji prefix — suffixed variants (💡例, ⚠️需) match via prefix of base emoji
# tomllm::TomllmDoc::strip_for_pipeline() strips lines WHERE line starts with any of these
strip_line_prefixes = ["# 🤓", "# 💡", "# ⚠️", "# 🔗", "# 🚩"]
# Note: tail-map block (# b00t:map v1 ... ) is preserved by strip_for_pipeline (extracted separately)
# Note: bare emoji prefix match catches all suffixed variants (💡例, 💡法, ⚠️需, ⚠️戒, etc.)
preserve_tail_map   = true

# b00t:map v1
# summary: b00t jargon datum — emoji+annotation filter registry for .tomllm tribal lexicon
# tags: jargon, tomllm, emoji, annotations, filters, 漢語, tribal
# tier: sm0l
# cmds: b00t learn jargon, grep "# 🤓" _b00t_/*.tomllm
# complexity: 2
