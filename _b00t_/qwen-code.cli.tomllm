# b00t CLI Datum — qwen-code (@qwen-code/qwen-code)
# Terminal AI coding agent optimized for Qwen3-Coder; OpenAI-API-compatible
# @tribal: binary is `qwen` not `qwen-code`; package is @qwen-code/qwen-code
# @tribal: supports DASHSCOPE_API_KEY (Alibaba Cloud) + standard OpenAI/Anthropic/Gemini keys
# @tribal: headless mode via `qwen -p "task"` (non-interactive, scriptable)
# @tribal: config at ~/.qwen/settings.json; project-local .qwen/settings.json overrides

[b00t]
name = "qwen-code"
type = "cli"
desires = "latest"
hint = "Qwen Code terminal AI coding agent (Alibaba/QwenLM) — Qwen3-Coder optimized, OpenAI-compat"
lfmf_category = "qwen-code"

install = """
npm install -g @qwen-code/qwen-code@latest
"""

update = """
npm install -g @qwen-code/qwen-code@latest
"""

# @example: qwen --version
version = "qwen --version"
version_regex = '([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)'

depends_on = ["node.cli"]

entangled_mcp = ["qwen-code.mcp"]
entangled_ai_models = ["qwen3-coder-local.model"]

[b00t.learn]
topic = "qwen-code"
auto_digest = true

[b00t.env]
# Priority: shell export > .env > ~/.qwen/settings.json env field
# @tribal: DASHSCOPE_API_KEY for Alibaba Cloud DashScope (native Qwen endpoint)
# DASHSCOPE_API_KEY = ""
# OPENAI_API_KEY = ""        # for OpenAI-compatible endpoints (local vLLM, mistralrs)
# OPENAI_BASE_URL = ""       # override endpoint; e.g. http://localhost:8000/v1

[[b00t.usage]]
description = "Interactive coding session (TUI)"
command = "qwen"

[[b00t.usage]]
description = "Headless one-shot task (scriptable)"
command = "qwen -p 'refactor the auth module to use JWT'"

[[b00t.usage]]
description = "Against local vLLM / mistralrs proxy"
command = "OPENAI_BASE_URL=http://localhost:8000/v1 OPENAI_API_KEY=local qwen -p 'explain this code'"

[[b00t.usage]]
description = "With DashScope (Alibaba Cloud) — native Qwen endpoint"
command = "DASHSCOPE_API_KEY=sk-... qwen"

[[b00t.usage]]
description = "Start MCP server mode (pipe to MCP client)"
command = "qwen --mcp-server"

[[b00t.references]]
name = "Qwen Code GitHub"
url = "https://github.com/QwenLM/qwen-code"

[[b00t.references]]
name = "DashScope API"
url = "https://dashscope.console.aliyun.com/"

[validate]
command = "qwen --version"
regex = "[0-9]+\\.[0-9]+"

[roles]
required_for = []
optional_for = ["developer", "orchestrator"]

# b00t:map v1
# summary: Qwen Code CLI — AI coding agent (terminal), Qwen3-Coder optimized
# tags: qwen, coding-agent, terminal, openai-compat, alibaba, npm
# tier: ch0nky
# cmds: qwen, qwen -p "task", qwen --mcp-server
# complexity: 3
