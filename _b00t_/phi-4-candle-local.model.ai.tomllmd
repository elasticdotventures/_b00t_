# b00t AI Model Datum — Microsoft Phi-4 14B, quantized GGUF, native candle runtime
# 🤓 Unlike qwen3-coder-local / gemma-4-26b-a4b-local, this is NOT vllm-podman: it's a
#    native Rust binary (b00t-candle-serve, crates.io candle-transformers 0.11.0) that
#    loads the GGUF directly — no container. CPU is the guaranteed-always-works path
#    (no GPU required — the RTX 3090 is contended/time-shared by ch0nky); as of
#    2026-08-04 it ALSO supports CUDA, opt-in and auto-detected at build time
#    (`just phi-candle build` enables --features cuda iff nvcc+libcudart are present),
#    with runtime CPU fallback if the GPU turns out busy/unavailable (select_device()
#    in b00t-candle-serve/src/main.rs). Check what's actually installed with
#    `just phi-candle build-info` or `b00t whoami` (Inference layer, "Candle CUDA").
# HF weights card: https://huggingface.co/microsoft/phi-4-gguf
# HF tokenizer card: https://huggingface.co/microsoft/phi-4
# Rust inference docs: https://github.com/microsoft/PhiCookBook ("Inference Phi with Rust")
# Candle upstream support: candle-transformers::models::quantized_phi3 (Phi-4 reuses the
#    phi3 GGUF architecture tag — see candle-examples/examples/quantized-phi/main.rs)
# Usage: just phi-candle::download && just phi-candle::run "your prompt"

[b00t]
name = "phi-4-candle-local"
type = "ai"
hint = "Phi-4 14B Q4_K GGUF, native candle-transformers runtime (no vLLM/podman); CPU always works, CUDA opt-in when built+free"
aliases = ["phi4", "phi-4", "phi-candle", "phi4-cpu", "phi4-cuda"]

[b00t.env]
PHI_CANDLE_MODEL_DIR = "~/.cache/huggingface/hub/models--microsoft--phi-4-gguf"
PHI_CANDLE_BIN = "b00t-candle-serve"

[model]
provider = "candle_native"
size = "medium"
capabilities = ["chat", "reasoning", "code"]
input_modalities  = ["text"]
input_formats     = ["text/plain", "text/markdown"]
output_modalities = ["text"]
# 🤓 (2026-08-26) now OpenAI-compatible: `b00t-candle-serve --serve` loads the model
#    once and exposes POST /v1/chat/completions + GET /v1/models (axum, same shape
#    as b00t-embed-serve's /v1/embeddings layer). One-shot CLI generation (see
#    service_contract below and _b00t_/phi-candle.just) is still the default mode
#    when --serve isn't passed. b00t-server discovers it as the "candle-phi" local
#    backend on port 8082 (b00t-mcp/src/server_llm.rs::default_soul()) — last in
#    priority among local openai-compat backends since CPU throughput is slow.
context_window = 16384
enabled = true
access_groups = ["default", "local", "cpu-fallback", "cuda-optional"]

[ai_model.parameters]
max_tokens = 1024
temperature = 0.2
repeat_penalty = 1.1

[ai_model.metadata]
hf_repo = "microsoft/phi-4-gguf"
tokenizer_repo = "microsoft/phi-4"
allow_patterns = "phi-4-Q4_K.gguf"
gguf_file = "phi-4-Q4_K.gguf"
# 🤓 Q4_K quant, ~8.43 GB (9,053,114,560 bytes) — fits comfortably on this box's 31GB RAM
#    (CPU path) or VRAM (CUDA path). Q5_K variants exist (~10.6GB) for higher fidelity
#    if RAM/VRAM/time budget allows; Q4_K chosen as the CPU-practical default.
runtime = "candle-native"
container_runtime = "none"
# 🤓 "optional" not "none": CUDA feature auto-enabled at build time when nvcc+libcudart
#    are detected (just phi-candle build), device picked at runtime with CPU fallback
#    (select_device() in b00t-candle-serve/src/main.rs) — never assumes the 3090 is free.
gpu = "optional (CUDA opt-in, auto-detected+compiled, runtime-selected with CPU fallback)"
crate = "b00t-candle-serve"
crate_path = "b00t-candle-serve/"
candle_transformers_module = "quantized_phi3::ModelWeights"

# ── Service contracts — verifiable capability handlers ────────────────────────
[[service_contract]]
capability  = "candle-runner-builds"
handler     = "cargo build --release -p b00t-candle-serve"
evidence    = "PASS: target/release/b00t-candle-serve exists, exit 0"
tier        = "sm0l"
verifiable  = true

[[service_contract]]
capability  = "local-cpu-inference"
handler     = "just phi-candle::run \"Q: What is the capital of France?\\nA:\""
evidence    = "PASS: stdout contains generated completion tokens after the prompt, nonzero tok/s reported on stderr"
tier        = "sm0l"
verifiable  = true
# 🤓 verified 2026-08-04: real end-to-end run on this box (4-core CPU, no GPU) —
#    `./target/release/b00t-candle-serve --prompt "Q: What is the capital of France?\nA:"`
#    completed the prompt with "A: Paris" (correct, coherent) at 0.53 tok/s;
#    model load ~2m23s (cold HF cache read of the 9.05GB GGUF) + 75.73s for 40 tokens.
#    CPU throughput is slow as expected for 14B Q4_K on 4 cores — usable for short
#    completions, not interactive chat latency.

[[service_contract]]
capability  = "local-cuda-inference"
handler     = "cargo build --release -p b00t-candle-serve --features cuda && ./target/release/b00t-candle-serve --prompt \"Q: What is the capital of France?\\nA:\" --sample-len 40"
evidence    = "PASS: stderr reports 'device: cuda:0' (not a CPU fallback), correct completion, tok/s well above the CPU baseline"
tier        = "sm0l"
verifiable  = true
# 🤓 verified 2026-08-04, RTX 3090, GPU otherwise idle: `--features cuda` build compiled
#    clean (cudarc 0.19.8 + candle-kernels against the host's CUDA 12.4 toolkit, ~6m40s).
#    Runtime confirmed via `device: cuda:0` in stderr + growing nvidia-smi VRAM usage
#    (566MB -> 3.5GB as weights loaded). IMPORTANT gotcha found: a short first run
#    (--sample-len 15) measured only 1.13 tok/s — misleadingly close to the CPU number —
#    because one-time CUDA kernel JIT/warmup dominates a tiny sample. A --sample-len 40
#    run (same length as the CPU baseline above) measured the real steady-state number:
#    49.20 tok/s, ~93x the CPU baseline. Always discount the first few tokens of any
#    CUDA-path benchmark on this binary, or use sample_len >= ~30 to amortize warmup.

[[service_contract]]
capability  = "openai-compatible-serve"
handler     = "cargo build --release -p b00t-candle-serve && ./target/release/b00t-candle-serve --serve --port 8082 &  sleep 1 && curl -s http://127.0.0.1:8082/v1/models"
evidence    = "PASS: GET /v1/models returns {\"data\":[{\"id\":\"candle-phi\",...}]}; POST /v1/chat/completions with an OpenAI-shaped {model,messages} body returns a choices[0].message.content completion"
tier        = "sm0l"
verifiable  = true

[[service_contract]]
capability  = "b00t-datum-authoring"
handler     = "b00t-cli --path _b00t_ viz entangle --datum phi-4-candle-local --format json"
evidence    = "PASS: valid JSON graph with phi-4-candle-local node + edges"
tier        = "sm0l"
verifiable  = true

# b00t:map v1
# summary: Phi-4 14B Q4_K GGUF served via native candle-transformers binary (b00t-candle-serve); CPU always works (0.53 tok/s), CUDA opt-in when built+free (49.2 tok/s verified), no container required
# tags: ai, phi, phi4, microsoft, candle, gguf, cpu-inference, cuda-inference, local-inference, sm0l
# tier: sm0l
# cmds: just phi-candle::download, just phi-candle::run, just phi-candle::build-info
# complexity: 4
