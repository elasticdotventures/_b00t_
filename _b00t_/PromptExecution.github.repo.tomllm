[b00t]
# 🤓 PromptExecution — org registry for adjacent hive repos
# 🤓 b00t-aligned org; all projects follow b00t patterns/approach
# 🤓 vendor/ submodules for internal projects; push to feat/elasticdotventures/_b00t_ branches ONLY
name = "PromptExecution"
type = "github_org"
hint = "PromptExecution GitHub org — b00t-aligned internal projects; never push to main"

[b00t.org]
github = "github.com/PromptExecution"
operator = "elasticdotventures"
# 🤓 push convention: feat/elasticdotventures/_b00t_ branch on all PromptExecution repos
# ⚠️需 NEVER push to main on PromptExecution repos; feature branches only
branch_convention = "feat/elasticdotventures/_b00t_"
alignment = "b00t-native"

# ─── Repositories ────────────────────────────────────────────────────────────────

[[b00t.repos]]
name = "irontology-mcp"
repo = "git@github.com:PromptExecution/irontology-mcp.git"
submodule_path = "vendor/irontology-mcp"
datum = "IrontologyMcp.mcp.tomllm"
status = "alpha"
# 🤓 semantic graph/RAG MCP server — 7-crate Rust workspace
# 🤓 NeumannStore: in-memory RDF triple store + vector similarity
# 🤓 Codegraph: tree-sitter AST → symbol graph (Rust + Python)
# 🤓 DSL: LALRPOP-compiled rule routing for file intake
# 🤓 Retrieval: 4-way fusion search (vector 0.35, graph 0.30, lexical 0.20, ontology 0.15)
# 🤓 Domain: energy client AEMO/NMI/DUID standing data spine (types pending)
description = "Semantic graph/RAG + code intelligence MCP server"
crates = ["codegraph", "domain", "dsl", "indexer", "mcp-server", "retrieval", "storage-neumann"]
# ⚠️ open: mcp-server has no main.rs (stdio transport needed)
# ⚠️ open: SearchBackend implementations are stubs (synthetic results)
# ⚠️ open: NeumannStore is in-memory only (no persistence)

[b00t.repos.integration]
# 🤓 _b00t_ branch mission: upstream b00t abstractions into irontology
#    while replacing b00t grok's broken Qdrant backend with NeumannStore
# 🤓 irontology adapts to b00t conventions, not the other way around
purpose = "fix grok subsystem via NeumannStore knowledge graph + semantic RAG"
replaces = "Qdrant vector DB (unreachable at 192.168.2.13:6333)"
# @tribal: b00t compatibility/alignment is paramount — irontology conforms to b00t, not inverse
upstream_target = "b00t grok subsystem (b00t-cli/src/commands/grok.rs, b00t-c0re-lib/src/grok.rs)"

[b00t.repos.integration.mapping]
# grok ask    → fusion_search (retrieval crate) — 4-way weighted: vector+graph+lexical+ontology
# grok digest → KnowledgeStore::upsert_embeddings + ingest_turtle
# grok learn  → index_file pipeline (indexer crate) — codegraph + DSL rules + embed
# grok status → NeumannStore health check

# ─── Future repos (register here as they are incorporated) ───────────────────────

# [[b00t.repos]]
# name = "next-project"
# repo = "git@github.com:PromptExecution/next-project.git"
# status = "planned"

[[b00t.usage]]
description = "List PromptExecution repos registered with b00t"
command = "grep -A2 'name =' _b00t_/PromptExecution.github.repo.tomllm"

[[b00t.usage]]
description = "Push irontology changes to correct branch"
command = "git -C vendor/irontology-mcp push origin HEAD:feat/elasticdotventures/_b00t_"

[[b00t.usage]]
description = "Update all vendor submodules"
command = "git submodule update --remote vendor/"

# b00t:map v1
# summary: PromptExecution org registry — b00t-aligned internal projects + vendor submodules
# tags: org, github, promptexecution, vendor, submodule, irontology
# tier: frontier
# cmds: git submodule update --remote vendor/
# complexity: 3
# prereqs: git SSH access to github.com/PromptExecution repos
