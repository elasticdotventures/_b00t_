[b00t]
name = "claude"
type = "runtime"
hint = "Claude Code CLI — sandboxed launch via b00t wrapper"

[b00t.runtime]
binary = "claude"

[b00t.runtime.isolation]
share_net = true
new_session = true

[[b00t.runtime.isolation.mounts]]
src = "/usr"
dest = "/usr"
type = "ro-bind"

[[b00t.runtime.isolation.mounts]]
src = "/lib"
dest = "/lib"
type = "ro-bind"

[[b00t.runtime.isolation.mounts]]
src = "/lib64"
dest = "/lib64"
type = "ro-bind"

[[b00t.runtime.isolation.mounts]]
src = "/bin"
dest = "/bin"
type = "ro-bind"

[[b00t.runtime.isolation.mounts]]
src = "/etc"
dest = "/etc"
type = "ro-bind"

[[b00t.runtime.isolation.mounts]]
src = "/home/brianh/.claude"
dest = "/home/brianh/.claude"
type = "bind"

[[b00t.runtime.isolation.mounts]]
src = ""
dest = "/tmp"
type = "tmpfs"

[[b00t.runtime.isolation.mounts]]
src = ""
dest = "/proc"
type = "proc"

# b00t:map v1
# summary: sandboxed claude code runtime — declarative isolation
# tags: claude, runtime, sandbox, anthropic
# tier: ch0nky
# cmds: b00t claude
# complexity: 3
