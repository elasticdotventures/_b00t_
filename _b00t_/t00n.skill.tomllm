[b00t]
name = "t00n"
type = "skill"
hint = "TOON (Token-Oriented Object Notation) format serializer for FOCUS records. Polyseme: toon|t00n. Canonical spec: https://github.com/toon-format/spec v3.0"

# 🤓 t00n is b00t's implementation of the TOON spec
# If a tomllmd has [b00t.schema] with format="t00n", the datum
# serializes data in t00n for token-efficient LLM consumption.

skills = ["t00n-serialization"]
entangled_cli = ["ledgrrr.cli"]
entangled_mcp = ["ledgerr-mcp.mcp"]

keywords = ["toon", "t00n", "serialization", "focus", "reqif", "validation", "contract"]

[b00t.schema]
format = "t00n"
spec = "https://github.com/toon-format/spec"
version = "3.0"
canonical_fields = ["BillingAccountId", "ServiceName", "BilledCost", "EffectiveCost", "ChargeCategory", "x_ExperimentId", "x_Variant"]

[b00t.validation]
reqif_yaml = "reqif.focus.yaml"
gate = "sm0l-logical-validator"
output_format = "PASS|FAIL:<requirement-id>:<reason>"

# ── Future: Virtual FUSE/io_uring skill storage ─────────────────────────────
# @tribal: Skills live on disk today. A future virtual filesystem backend
# would mount t00n-serialized FOCUS records as an in-memory file tree,
# allowing sandboxed agent processes to read/write cost records through
# standard POSIX I/O — no MCP channel needed.
#
# Candidate crates (all available on crates.io):
#   fuse-backend-rs = "0.14"  — production FUSE server + virtio-fs
#   io-uring = "0.7"          — kernel-bypass async I/O for sandbox page faults
#   memfs = "0.1"             — in-memory filesystem structure
#   bare-vfs = "0.3"          — no_std virtual filesystem for WASM sandboxes
#   microsandbox-filesystem   — gVisor-style filesystem backend
#
# Design sketch (not implemented):
#   SkillStorage trait (DiskStorage | MemStorage | FuseStorage | RemoteStorage)
#   ↓
#   FuseStorage: fuse-backend-rs FuseSession + toon-serialized trie
#     → mount at ~/.b00t/vfs/skills/<name>/SKILL.md
#     → reads: SkillResolver.load() → FuseStorage::read() → toon-deserialize
#     → writes: agent modifies skill → toon-serialize → fuse notify
#   io_uring variant: share page-cache between b00t-mcp and sandbox via
#     io_uring registered buffers — zero-copy skill injection
#
# For now: skills are loaded from disk with timeout+cache (skill_resolver.rs).
# The VFS layer is a future optimization for when skills need to be served
# to sandboxed processes that cannot read the host filesystem directly.
[b00t.vfs]
status = "stub"
phase = "future"
candidates = ["fuse-backend-rs", "io-uring", "memfs", "bare-vfs", "microsandbox-filesystem"]
trait = "SkillStorage"
backends = ["DiskStorage", "MemStorage", "FuseStorage", "RemoteStorage"]
