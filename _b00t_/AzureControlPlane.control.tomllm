[b00t]
# 🤓 b00t Azure Control Plane — on-demand ACI compute via MCP + heartbeat/lease model
# 🤓 Repo: ~/.b00t/b00t-tf/modules/azure-control-plane/ (terraform)
# 🤓 Server: ~/.b00t/b00t-azure-cp/ (Rust MCP server crate)
# 🤓 Image: ghcr.io/elasticdotventures/b00t-azure-cp:latest
name = "AzureControlPlane"
type = "mcp_server"
hint = "Rust MCP server on ACA — spin up/down ACI containers on-demand with auto-TTL teardown"

[b00t.mcp]
# 🤓 MCP endpoint populated after `tofu apply` in b00t-tf/
# 🤓 Set min_replicas=0 for free (scale-to-zero, ~30s cold start)
# 🤓 Set min_replicas=1 for always-warm (~$3 AUD/month)
transport = "streamable-http"
endpoint_template = "https://{aca_fqdn}/mcp"

[b00t.tools]
# 🤓 Five MCP tools exposed by the control plane server:
provision_aci  = "Spin up an ACI container (GPU/CPU inference). Returns endpoint_url + lease_id."
deprovision    = "Tear down a container by lease_id. Immediate; stops billing."
heartbeat      = "Renew lease TTL. Call every N min to keep resource alive past default TTL."
list_leases    = "List active leases with endpoint URLs, TTLs, and resource IDs."
cost_estimate  = "Estimated current-month spend for the control plane resource group."

[b00t.lease]
# 🤓 Leases stored in Azure Table Storage (b00tLeases table)
# 🤓 Default TTL: 30 minutes. Watchdog runs every 60s, tears down expired leases.
# 🤓 Heartbeat call resets expiry to now() + ttl_minutes.
partition_key = "node_id"
row_key       = "lease_id (uuid v4)"
fields        = ["resource_id", "resource_type", "endpoint_url", "expires_at", "created_at", "client_hint"]
default_ttl_minutes = 30
watchdog_interval_seconds = 60

[b00t.terraform]
# 🤓 Module lives in b00t repo (self-provisioning from b00t node)
module_path = "~/.b00t/b00t-tf/modules/azure-control-plane"
# 🤓 b00t-node-budget module also attached to control plane RG ($10 AUD/month alert)
budget_module = "~/.b00t/b00t-tf/modules/b00t-node-budget"

[b00t.budget]
# 🤓 min_replicas=0 (default): free at idle, ACI costs only while provisioned
# 🤓 min_replicas=1: ~$3 AUD/month baseline (1x 0.25vCPU/0.5Gi ACA replica)
# 🤓 Budget guard: $10 AUD/month on rg-b00t-control-{node_id}
idle_cost_aud = 0
always_warm_aud = 3
budget_guard_aud = 10

[[b00t.usage]]
description = "Add control plane MCP to claude-cli (after tofu apply)"
command = """# 1. Get the MCP endpoint URL:
#    tofu -chdir=~/.b00t/b00t-tf output mcp_endpoint
# 2. Add to ~/.config/claude/mcp_config.json:
{
  "mcpServers": {
    "b00t-azure-cp": {
      "transport": "http",
      "url": "https://<aca_fqdn>/mcp"
    }
  }
}"""

[[b00t.usage]]
description = "Provision an on-demand ACI inference container"
command = """# Via MCP tool call in claude-cli:
azure.provision_aci {
  "image": "ghcr.io/elasticdotventures/my-inference-server:latest",
  "cpu": 4,
  "memory_gb": 16,
  "gpu_count": 1,
  "gpu_sku": "V100",
  "lease_ttl_minutes": 30
}
# Returns: { endpoint_url, lease_id, expires_at }"""

[[b00t.usage]]
description = "Keep resource alive beyond default TTL"
command = """# Call heartbeat every 25 min (before 30 min TTL expires):
azure.heartbeat { "lease_id": "<uuid>" }
# Returns: { lease_id, new_expires_at }"""

[[b00t.usage]]
description = "Provision the control plane itself (tofu)"
command = """module "azure_control_plane" {
  source            = "~/.b00t/b00t-tf/modules/azure-control-plane"
  node_id           = "my-node-id"
  location          = "australiaeast"
  min_replicas      = 0        # 0 = free scale-to-zero, 1 = always-warm
  lease_ttl_minutes = 30
  budget_aud        = 10
  alert_emails      = ["me@example.com"]
}
# Then: tofu apply → outputs.mcp_endpoint"""

# b00t:map v1
# summary: b00t Azure Control Plane — on-demand ACI compute via MCP, heartbeat/lease model
# tags: azure, aca, aci, mcp, rust, control-plane, on-demand-compute, lease
# tier: frontier
# cmds: azure.provision_aci, azure.deprovision, azure.heartbeat, azure.list_leases
# complexity: 7
# prereqs: az login, tofu apply in b00t-tf/, AZURE_SUBSCRIPTION_ID
