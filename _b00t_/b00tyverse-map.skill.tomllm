[b00t]
name = "b00tyverse-map"
type = "skill"
hint = "b00tyverse ecosystem map: the portfolio graph of platforms, client projects, and assimilated vendor forks with cake (🎂) provenance per entry"

[b00t.schema]
type = "skill"
type_tags = ["b00tyverse", "portfolio", "ecosystem", "map", "cake", "provenance", "tax-lawyer", "doggolingo", "vendor"]

[b00t.skill]
depends_on = []
unlocks = [
    "b00tyverse-map::orient",
    "b00tyverse-map::value-entry",
]

# ── b00tyverse Ecosystem Map ──────────────────────────────────────────────────
#
# The b00tyverse is the ontological catalog of everything the hive builds and
# assimilates. Portfolio law (recorded 2026-07): demote to datums, NEVER
# dismiss — datums cost thousands to produce; salvage, don't discard.
#
# Value unit is cake (🎂) = desire/attention. NEVER usd — USD is only an
# external exchange rate. Per entry:
#   production_cost_cake  = attention spent to create/assimilate it
#   retrieval_value_cake  = attention saved each time the hive retrieves it
#
# ── The Three Currents ────────────────────────────────────────────────────────
#
# 1. TAX-LAWYER PLATFORM — the PromptExecution ecosystem flagship.
#    MCP-down: ledgerr_* tax actions are thin (<=10 line) wrappers over
#    Satisfies<Constraint> checks. UFO-up: ufo-types grounds every domain
#    concept in UFO stereotypes with ISO standard types. The Satisfies<T>
#    trait bridges both currents and emits arc-kit-au evidence nodes for the
#    audit trail. Spec: _b00t_/datums/PRD-TAX-LAWYER-UFO-SDD.tomllmd
#    (issues #510-#517).
#
# 2. DOGGOLINGO — app4dog client project. Contributes physics/simulation
#    generative-modelling capability back to the b00tyverse. Playable-first:
#    working local game loop (P0 tap-the-sheep) before backend/cloud/ML.
#    ComfyUI exploration is legacy — stage ideas get extracted into typed
#    b00t business logic, never into the game runtime.
#
# 3. VENDOR/ SUBMODULES — assimilated forks. Fork-fix-forward doctrine:
#    each fork exists to carry a fix or a b00t adaptation upstream, and its
#    assimilation cost is sunk cake that pays out on every retrieval.

# ── Platform Entries ──────────────────────────────────────────────────────────

[[b00t.map.entry]]
name = "tax-lawyer-platform"
kind = "platform"
owner = "PromptExecution"
contributes = ["satisfies-constraint-pattern", "arc-kit-au-evidence-graph", "ufo-types", "iso-standard-types", "ledgerr-mcp-tools"]
anchors = ["_b00t_/datums/PRD-TAX-LAWYER-UFO-SDD.tomllmd", "vendor/ledgrrr"]
production_cost_cake = 900
retrieval_value_cake = 85

[[b00t.map.entry]]
name = "doggolingo"
kind = "client-project"
owner = "app4dog"
contributes = ["physics-simulation", "generative-modelling", "playable-first-pattern", "local-telemetry-json"]
anchors = ["SOUL.tomllm [doggolingo]", "._b00t_/doggolingo.stack.tomllm", "docs/DOGGOLINGO_CLEANUP_PLAN.md"]
production_cost_cake = 550
retrieval_value_cake = 40

[[b00t.map.entry]]
name = "b00t-harness"
kind = "platform"
owner = "PromptExecution"
contributes = ["datum-type-system", "ooda-loop", "lfmf-telemetry", "blessing-graph", "hive-a2a"]
anchors = ["b00t-cli/src/lib.rs", "_b00t_/"]
production_cost_cake = 1200
retrieval_value_cake = 120

