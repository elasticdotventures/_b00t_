# ── Recipes ───────────────────────────────────────────────────────────────────

[b00t.skill.recipes."b00tyverse-map::orient"]
description = "Orient a fresh agent inside the portfolio graph"
steps = [
    "1. Read this map's entries; identify which current your task serves (tax-lawyer / doggolingo / harness / vendor)",
    "2. git config -f .gitmodules --get-regexp path — live inventory of assimilated forks vs this map",
    "3. b00t-cli ontology sparql --subject <entry-name> --predicate all — walk the entry's type-graph neighbors",
    "4. Before writing anything new: does an entry already contribute this capability? (DRY+NRtW)",
    "5. Report which entry your work extends — orphan work belongs to no current and gets lost",
]

[b00t.skill.recipes."b00tyverse-map::value-entry"]
description = "Appraise or re-appraise an entry's cake provenance"
steps = [
    "1. production_cost_cake = attention actually spent (sessions, debugging, assimilation) — sunk, never revise downward",
    "2. retrieval_value_cake = attention saved per retrieval; revise from lfmf/usage telemetry (b00t lfmf stats <tool>)",
    "3. Low retrieval value is NEVER grounds for deletion — demote to datum, salvage the knowledge",
    "4. New assimilation: add a [[b00t.map.entry]] here with both cake fields; b00t-lsp --check _b00t_ must stay clean",
    "5. NEVER denominate in usd — cake is the canonical unit; USD is only an external exchange rate",
]

[b00t.compose]
composes_with = [
    "datums/PRD-TAX-LAWYER-UFO-SDD",
    "harness-loop-engineer",
    "datum-review",
    "reviewer.role",
    "repo.datum",
]

# b00t:map v1
# summary: b00tyverse portfolio graph — tax-lawyer platform, doggolingo client capability, assimilated vendor forks, cake (🎂) provenance per entry
