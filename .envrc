# b00t direnv configuration
# Loads .env.defaults first (committed safe defaults), then .env (gitignored secrets)

# Load committed defaults
dotenv_if_exists .env.defaults

# Overlay with local secrets (gitignored)
dotenv_if_exists .env

# b00t-specific: add vendor binaries to PATH
PATH_add vendor/rust-docs-mcp-server/target/release
PATH_add vendor/ledgrrr/target/release
