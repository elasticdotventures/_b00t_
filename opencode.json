{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "b00t-mcp": {
      "command": [
        "b00t-mcp",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "codebase-memory": {
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "rust-doc": {
      "command": [
        "vendor/rust-docs-mcp-server/target/release/rustdocs_mcp_server",
        "serde"
      ],
      "enabled": true,
      "type": "local",
      "environment": {
        "OPENAI_API_BASE": "http://127.0.0.1:8001/v1",
        "OPENAI_API_KEY": "local-b00t"
      },
      "timeout": 60000
    }
  },
  "model": "qwen36-local/ch0nky",
  "provider": {
    "deepseek": {
      "api": "https://api.deepseek.com",
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible"
    },
    "qwen36-local": {
      "models": {
        "ch0nky": {
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "name": "ch0nky",
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        }
      },
      "name": "Qwen3.6 Local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "local-b00t",
        "baseURL": "http://127.0.0.1:8001/v1"
      }
    }
  },
  "small_model": "qwen36-local/ch0nky"
}
