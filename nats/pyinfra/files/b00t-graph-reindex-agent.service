# Modeled on b00t-historian.service's shape (this same directory).
#
# Runs `b00t-graph watch` (b00t-c0re-lib/examples/b00t-graph.rs, built with
# --features store-oxigraph): subscribes to the best-effort b00t.graph.reindex
# hint (published by graph-artifact-publish.yml, see docs/superpowers/specs/
# 2026-09-11-sp5-graph-artifact-publish-design.md), pulls the tagged Turtle
# artifact from S3, and replaces the contents of a persistent local Oxigraph
# store (~/.b00t/<backend>/graph-reindex) on each event.
#
# NATS_URL and GRAPH_ARTIFACT_S3_BUCKET are REQUIRED (clap `env = "..."`, no
# default) — deliberately not guessed here. Unlike b00t-historian.service,
# Requires=b00t-nats.service is OMITTED: sm3lly/fung1 are plain worker nodes,
# not the control node, and whether they reach a local or remote NATS server
# is exactly what NATS_URL in the EnvironmentFile below must answer per-node.
#
# No signature verification yet (v1 decision, matches kr0ki#13 — S3 access
# itself is the trust boundary for now).
#
# Build: cargo build --release -p b00t-c0re-lib --example b00t-graph \
#          --no-default-features --features store-oxigraph
#        -> target/release/examples/b00t-graph

[Unit]
Description=b00t-graph-reindex-agent — pulls signed graph artifacts on b00t.graph.reindex hint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/b00t-graph watch
Restart=always
RestartSec=5
EnvironmentFile=/etc/b00t-graph-reindex-agent.env
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
