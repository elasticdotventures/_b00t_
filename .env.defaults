# b00t LLM Proxy — safe defaults (committed)
# Override in .env (gitignored) for real keys

# LLM backend for b00t-admin proxy
LLM_BACKEND_URL=http://localhost:15115

# OpenAI-compatible base URL — routes through b00t-admin proxy
# Tools using OpenAI SDK set this to b00t-admin
OPENAI_BASE_URL=http://localhost:31337/v1

# API key — b00t-admin proxy accepts any non-empty key
# Set real key in .env for external API access
OPENAI_API_KEY=b00t-proxy-key

# Admin server
ADMIN_PORT=31337
ADMIN_HOST=0.0.0.0
