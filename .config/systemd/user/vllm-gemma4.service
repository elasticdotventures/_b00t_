# vLLM hive inference node — Gemma 4 E4B NVFP4A16 (port 8001)
# 🤓 2imi9/gemma-4-E4B-it-NVFP4A16: NVFP4A16 quant; native vLLM Gemma4 (no GGUF needed)
#    unsloth MXFP4_MOE GGUF is UNSUPPORTED — transformers Gemma4 GGUF arch not yet mapped
# 🤓 served-model-name=ch0nky: aligns with b00t hive ch0nky tier + opencode/pi routing
# 🤓 --enforce-eager: avoids Triton CUDA graph compilation deadlock on RTX 3090
# Install: systemctl --user daemon-reload && systemctl --user enable --now vllm-gemma4
# Logs:    journalctl --user -u vllm-gemma4 -f
# HF card: https://huggingface.co/2imi9/gemma-4-E4B-it-NVFP4A16

[Unit]
Description=vLLM Gemma 4 E4B NVFP4A16 hive inference node (port 8001)
After=network.target
Wants=network.target

[Service]
Type=simple
LimitNOFILE=65536

Environment="PATH=%h/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HOME=%h/.cache/huggingface"
Environment="VLLM_WORKER_MULTIPROC_METHOD=spawn"

ExecStart=/usr/bin/env vllm serve \
    2imi9/gemma-4-E4B-it-NVFP4A16 \
    --served-model-name ch0nky \
    --port 8001 \
    --enforce-eager \
    --enable-auto-tool-choice \
    --tool-call-parser pythonic

Restart=on-failure
RestartSec=30s
TimeoutStartSec=300

[Install]
WantedBy=default.target
