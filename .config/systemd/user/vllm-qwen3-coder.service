# vLLM hive inference node — Qwen3-Coder-Next Q4_K_M
# Install: systemctl --user daemon-reload && systemctl --user enable --now vllm-qwen3-coder
# Logs:    journalctl --user -u vllm-qwen3-coder -f
# ⚠️  ulimit prerequisite (run once as root):
#   echo "* soft nofile 65536" >> /etc/security/limits.conf
#   echo "* hard nofile 65536" >> /etc/security/limits.conf
#   echo "session required pam_limits.so" >> /etc/pam.d/common-session

[Unit]
Description=vLLM Qwen3-Coder hive inference node (port 8000)
After=network.target
Wants=network.target

[Service]
Type=simple
# 🤓 LimitNOFILE bypasses ulimit for systemd; avoids fd exhaustion under load
LimitNOFILE=65536

Environment="PATH=/home/brianh/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HOME=/home/brianh/.cache/huggingface"
Environment="VLLM_WORKER_MULTIPROC_METHOD=spawn"

ExecStartPre=/bin/bash -c 'echo "vllm hive node starting on :8000"'
ExecStart=/home/brianh/.venv/bin/vllm serve \
    %h/.cache/huggingface/hub/models--Qwen--Qwen3-Coder-Next-GGUF/snapshots/main/Qwen3-Coder-Next-Q4_K_M/Qwen3-Coder-Next-Q4_K_M-00001-of-00004.gguf \
    --served-model-name qwen3-coder \
    --port 8000 \
    --max-model-len 32768 \
    --cpu-offload-gb 28 \
    --enable-auto-tool-choice \
    --tool-call-parser hermes \
    --enable-chunked-prefill \
    --override-generation-config '{"temperature": 0.25, "min_p": 0, "top_p": 0.8}'

Restart=on-failure
RestartSec=30s
TimeoutStartSec=300

[Install]
WantedBy=default.target
