list-commands:
	find ~/.dotfiles/_b00t_/*.toml

# Run the b00t-cli with all passed arguments
cli *args:
	cargo run --bin b00t-cli -- {{args}}

# Test MCP functionality with sample files
test-mcp:
	cargo run -- mcp add "$(cat samples/mcp/playwright.json)"
	cargo run -- mcp add --dwiw "$(cat samples/mcp/with-comments.json)"
	cargo run -- mcp add "$(cat samples/mcp/direct-format.json)"
	cargo run -- mcp list
	cargo run -- mcp list --json

# Test VSCode integration (will show manual command if VSCode not available)
test-vscode:
	cargo run -- vscode install mcp playwright
	cargo run -- vscode install mcp github
	cargo run -- vscode install mcp filesystem

# Test Claude Code integration (will show manual command if claude-code not available)
test-claude-code:
	cargo run -- claude-code install mcp playwright
	cargo run -- claude-code install mcp github
	cargo run -- claude-code install mcp filesystem

# Usage:
#   just bump                # defaults to "patch"
#   just bump minor          # or "major"

bump level = "patch":
	#!/usr/bin/env bash
	if [[ "{{level}}" != "patch" && "{{level}}" != "minor" && "{{level}}" != "major" ]]; then
		echo "Invalid bump level: '{{level}}'. Must be one of: patch, minor, major." >&2;
		exit 1;
	fi
	cargo install --quiet cargo-release --locked || true
	echo "Bumping version: {{level}}"
	cargo release {{level}} --no-publish --no-push --no-confirm

noop:
	@echo "Noop command executed. This is a placeholder for future commands."

# Grok semantic E2E tests — unit tier (no service required, always run)
# Release gate: must pass before cog bump / git release
grok-e2e-unit:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "🧠 Running grok unit E2E tests (no service required)..."
	cargo build --bin b00t-cli 2>&1
	cargo test --test grok_semantic_e2e_test 2>&1
	cd .. && cargo test --package b00t-c0re-lib --test grok_raglight_e2e_test 2>&1
	echo "✅ grok unit E2E tests passed"

# Grok semantic E2E tests — integration tier (requires raglight Python service)
# Usage: just grok-e2e-integration   (set TEST_RAGLIGHT=1 implicitly)
grok-e2e-integration:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "🧠 Running grok integration E2E tests (requires raglight)..."
	cargo build --bin b00t-cli 2>&1
	TEST_RAGLIGHT=1 cargo test --test grok_semantic_e2e_test -- --include-ignored 2>&1
	cd .. && TEST_RAGLIGHT=1 cargo test --package b00t-c0re-lib --test grok_raglight_e2e_test -- --include-ignored 2>&1
	echo "✅ grok integration E2E tests passed"

# Full grok E2E suite: unit + integration
# Use this as the release gate
grok-e2e: grok-e2e-unit
	@echo "✅ grok-e2e unit tier complete (run grok-e2e-integration for full pipeline)"

# l3dg3rr docgen proxy — query knowledge graph, emit .tomllm / rustdoc
# 🌐 Docgen UI server: cd vendor/... && ./build/c/codebase-memory-mcp --ui=true --port=9749
docgen: project="home-brianh-.b00t-vendor-codebase-memory-mcp-b00t-ir0n-ledg3rr" format="tomllm" limit="20"
	@echo "📚 Querying l3dg3rr knowledge graph (project={{project}}, format={{format}}, limit={{limit}})..."
	@python3 ../vendor/codebase-memory-mcp-b00t-ir0n-ledg3rr/_b00t_/scripts/l3dg3rr-doc-proxy.py \
		--project={{project}} --format={{format}} --limit={{limit}}

# l3dg3rr docgen: quick toml export (default)
docgen-toml:
	@just docgen

# l3dg3rr docgen: rustdoc-style export
docgen-rustdoc:
	@just docgen "" rustdoc

# l3dg3rr docgen: raw JSON graph dump
docgen-json:
	@just docgen "" json 50

# 🔌 Promote b00t as Hermes terminal backend (guard-gated execution)
# Symlinks the b00t environment backend into Hermes and activates it.
hermes-backend-enable:
	@echo "🔌 Installing b00t environment backend into Hermes..."
	@ln -sf ~/.hermes/skills/devops/b00t-hermes-env/scripts/b00t_env_backend.py \
		~/.hermes/hermes-agent/tools/environments/b00t.py
	@echo "   Symlink created. To activate:"
	@echo "   hermes config set terminal.backend b00t"
	@echo "   hermes config set terminal.timeout 180"
	@echo "   Then restart: hermes (CLI) or systemctl --user restart hermes-gateway"
	@echo ""
	@echo "📋 All terminal commands now route through b00t guard system:"
	@echo "   pip install  → 🦨 uv pip install"
	@echo "   docker run   → 🦨 podman run"
	@echo "   rm -rf /     → 🚫 BLOCKED"

hermes-backend-disable:
	@echo "🔌 Removing b00t environment backend..."
	@rm -f ~/.hermes/hermes-agent/tools/environments/b00t.py
	@echo "   hermes config set terminal.backend local

# 🛡️ Guard lint — validates every .hive.toml datum shipped with b00t
# Scans all shipped datums, verifies every Rhai expression compiles and
# evaluates correctly. Run on version bump or before merge to main.
lint-guards:
	@echo "🔍 Scanning all shipped .hive.toml guard datums..."
	cargo test -p b00t-cli --lib -- guard_expr_coverage --nocapture 2>&1 | tail -5
	@echo "✅ guard lint passed"

# Pre-release gate: runs grok E2E + guard lint + full cargo test suite
# Wire to cog pre-bump-hook or call manually before any version bump
pre-release-check:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "🚦 Pre-release checks starting..."
	echo ""
	echo "1/4 cargo test (full suite)..."
	cargo test 2>&1
	echo ""
	echo "2/4 guard lint (Rhai expression coverage)..."
	just lint-guards
	echo ""
	echo "3/4 grok E2E unit tests..."
	just grok-e2e-unit
	echo ""
	echo "4/4 b00t-c0re-lib tests..."
	cd .. && cargo test --package b00t-c0re-lib 2>&1
	echo ""
	echo "✅ All pre-release checks passed — safe to bump version"

