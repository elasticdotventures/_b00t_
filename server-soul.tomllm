# b00t server soul — runtime backend registry (local, uncommitted)
# Edit to add/remove backends. Remote entries reference env var keys.
# b00t:map v1
# summary: b00t-server backend discovery config
# tags: server, soul, backends
# tier: sm0l
# cmds: b00t server start
# complexity: 2
#
[soul]
hostname = "LappyX23"
blessings = ["rust-doc"]

[[backends.local]]
name = "mistralrs"
port = 8181
kind = "openai-compat"
enabled = true

[[backends.local]]
name = "llama-cpp"
port = 8080
kind = "openai-compat"
enabled = true

[[backends.local]]
name = "vllm"
port = 8000
kind = "openai-compat"
enabled = true

[[backends.remote]]
name = "openai"
key_env = "OPENAI_API_KEY"

[[backends.remote]]
name = "openrouter"
key_env = "OPENROUTER_API_KEY"
base_url = "https://openrouter.ai/api/v1"
