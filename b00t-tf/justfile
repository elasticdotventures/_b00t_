# b00t-tf Development Justfile
# Memoizes OpenTofu infrastructure development commands

set dotenv-load

# Default recipe - show available commands
default:
    @just --list

# === DEVELOPMENT ===

# Install MCP SDK dependencies
install-deps:
    npm install
    @echo "✅ MCP SDK dependencies installed"

# Test MCP server locally
test-server: install-deps
    @echo "🧪 Testing MCP server locally..."
    node proxy-server.js --help || echo "Server startup test complete"

# Test self-bootstrapping functionality
test-bootstrapping: install-deps
    @./scripts/test-bootstrapping.sh

# === TERRAFORM/OPENTOFU ===

# Render _b00t_.toml + _b00t_/keyring.tomllm -> generated.auto.tfvars.json.
# OpenTofu has no native tomldecode; this is the stdlib prestep (b00t task #187
# tracks a real function-provider to replace it). Idempotent, fast, no creds.
tf-render:
    python3 scripts/render-tfvars.py

# Initialize OpenTofu
tf-init: tf-render
    tofu init
    @echo "✅ OpenTofu initialized"

# Plan infrastructure changes
tf-plan: tf-init
    tofu plan
    @echo "📋 OpenTofu plan complete"

# Apply infrastructure (requires confirmation)
tf-apply: tf-init
    tofu apply
    @echo "🚀 Infrastructure applied"

# Destroy infrastructure (requires confirmation)
tf-destroy: tf-init
    tofu destroy
    @echo "💥 Infrastructure destroyed"

# One-time: migrate root state local -> gcs backend (after `just gcp-bootstrap`).
tf-init-migrate:
    tofu init -migrate-state
    @echo "✅ root state migrated to gs://b00t-tf-state-promptexecution"

# Provider-only init + validate/fmt — no backend, no creds, no state. CI-safe.
tf-check: tf-render
    tofu init -backend=false
    tofu validate
    tofu fmt -check -recursive
    tofu -chdir=modules/gcp-build-plane init -backend=false
    tofu -chdir=modules/gcp-build-plane validate

# === GCP BUILD PLANE (root module, gcs state) ===
# Author: plan gleaming-jingling-nygaard Phase 2. Needs `just tf-init-migrate`
# once, then operator ADC + the keyring datum populated (Phase 0 input #3).

# Scoped plan for the build-plane module only.
gcp-plan: tf-init
    tofu plan -target=module.gcp_build_plane

# Scoped apply for the build-plane module only.
gcp-apply: tf-init
    tofu apply -target=module.gcp_build_plane
    @echo "🚀 gcp-build-plane applied"

# === GCP BOOTSTRAP (one-time, local state) ===
# Creates the GCS remote-state bucket + enables the GCP APIs the root
# `gcp-build-plane` module needs. Separate local-state module — run once with
# operator Application Default Credentials. See modules/gcp-bootstrap/README.md.

gcp-bootstrap:
    tofu -chdir=modules/gcp-bootstrap init
    tofu -chdir=modules/gcp-bootstrap apply
    @echo "✅ gcp-bootstrap applied — remote-state bucket + APIs ready"

# Read-only preview of the bootstrap.
gcp-bootstrap-plan:
    tofu -chdir=modules/gcp-bootstrap init
    tofu -chdir=modules/gcp-bootstrap plan

# GUARDED teardown. The state bucket has prevent_destroy=true — migrate root
# state back to local (tofu init -migrate-state) and remove that lifecycle
# block in modules/gcp-bootstrap/main.tf FIRST.
gcp-bootstrap-destroy:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "⚠️  This destroys the OpenTofu remote-state bucket for the whole build plane."
    read -rp "Type 'destroy-bootstrap' to continue: " ans
    [ "$ans" = "destroy-bootstrap" ] || { echo "aborted"; exit 1; }
    tofu -chdir=modules/gcp-bootstrap destroy
    echo "💥 gcp-bootstrap destroyed"

# === VALIDATION ===

# Validate manifest.json schema
validate-manifest:
    @echo "🔍 Validating manifest.json..."
    @which jq >/dev/null || (echo "❌ jq not found - install with: sudo apt install jq" && exit 1)
    jq . manifest.json > /dev/null && echo "✅ manifest.json is valid JSON"

# Validate all configuration files
validate: validate-manifest
    @echo "🔍 Validating _b00t_.toml..."
    @test -f _b00t_.toml && echo "✅ _b00t_.toml exists"
    @echo "🔍 Validating .env.template..."
    @test -f .env.template && echo "✅ .env.template exists"

# === BASE TEMPLATE GENERATION ===

# Create base .dxt template for Cloudflare Worker modification
create-base-template: install-deps
    #!/usr/bin/env bash
    echo "📦 Creating base .dxt template..."
    mkdir -p template
    
    # Check for zip command
    if ! which zip >/dev/null 2>&1; then
        echo "❌ zip command not found. Install with: sudo apt install zip"
        exit 1
    fi
    
    # Create base template zip (without user-specific _b00t_.toml)
    zip -r template/b00t-base.dxt \
        manifest.json \
        package.json \
        proxy-server.js \
        main.tf \
        modules/ \
        .env.template \
        node_modules/
    
    echo "✅ Base template created: template/b00t-base.dxt"
    ls -lh template/b00t-base.dxt

# Test base template contents
test-base-template:
    @echo "🔍 Testing base template contents..."
    @test -f template/b00t-base.dxt || (echo "❌ Base template not found. Run: just create-base-template" && exit 1)
    unzip -l template/b00t-base.dxt | head -15
    @echo ""
    @echo "📊 Base template size:"
    ls -lh template/b00t-base.dxt

# === UTILITIES ===

# Clean build artifacts
clean:
    rm -rf node_modules/
    rm -rf .terraform/
    rm -f .terraform.lock.hcl
    rm -rf template/
    @echo "🧹 Cleaned build artifacts"

# Setup development environment
setup: install-deps tf-init validate
    @echo "✅ Development environment ready"

# Show current status
status:
    @echo "📊 b00t-tf Status:"
    @echo "OpenTofu: $(which tofu || echo 'not installed')"
    @echo "Node.js: $(node --version 2>/dev/null || echo 'not installed')"
    @echo "NPM: $(npm --version 2>/dev/null || echo 'not installed')"
    @test -d node_modules && echo "Dependencies: ✅ installed" || echo "Dependencies: ❌ missing"
    @test -f .terraform.lock.hcl && echo "OpenTofu: ✅ initialized" || echo "OpenTofu: ❌ not initialized"

# === ALIASES ===

alias s := status
alias c := clean
alias v := validate
alias template := create-base-template
alias test-template := test-base-template